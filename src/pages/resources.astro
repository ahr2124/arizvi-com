---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Resource from '../components/Resource.astro';
import Quote from '../components/Quote.astro';
import StartTiles from '../components/StartTiles.astro';
import { comments, stepComments } from '../data/students';
import data from '../data/resources.json';
// Teaching resources, at /resources/ with its own place in the top nav. History, in Ali's words (11-12 Nov 2026):
// "a new section on my site for teaching resources and we upload actual assignment insturctions, rubrics etc there?";
// "take true examples from everywhere"; "the whole page is now about GRADING ... Put a few more sections in. Then add a
// table, like Strategy Name | Class 1 | Class 2"; "put a carousel of strategies followed by "Where I used them"";
// "internal site fixes"; then "run a full useability audit and make the resources page inviting to use ... I feel like
// the black-and-white is taking away from the goal of the site which is to show people that I am actually good at
// teaching. Let's add maybe one accent colour and make this page phenomenal."
// So this page, and only this page, has one accent colour: a highlighter yellow (--hl in global.css), always behind black
// text. It does four jobs: the claim (the opening line, in Ali's words, 12 Nov 2026: "I think the subtitle should say
// something like I love experimenting with pedagogy to get to the best outcome for my students… make it a little better,
// but this is the overall line"), the evidence (the X marks, the band on the
// Start here tiles, the bar beside each student's words), where you are (the group or chip that is on, an open piece) and
// the standard (the best level of each rubric). Labels and course codes stay black and white; the pale --hl-soft marks
// what you can press (hover, the filter panel).
// The first audit found the first real piece about 3 screens down, no entry points and no sign of the teaching working.
// A fresh usability test of the redesign (12 Nov) asked for where and how much he taught and a student up top, a table
// header that stays in view, the box opening beside its X, fewer tab stops, a filter that hides what it leaves out, and
// a way around long pieces. Every brief and rubric is the one students got on LEARN, from his instructor shells
// (src/data/resources.json): LEARN pages and rubrics converted by script, PDF and Word briefs typed and checked word for
// word against the file.
type Item = { id: string; course?: string; title: string; term: string; kind: string; tags: string[]; brief: string; rubrics: any[]; note?: string };
type Sec = { id: string; label: string; items: Item[] };
type Row = { name: string; desc: string; refs: string[]; link: string | null; marks: Record<string, string> };
const sections = data.sections as Sec[];
const { cols, groups } = data.strategies as { cols: string[]; groups: { name: string; rows: Row[] }[] };
const cards = groups.flatMap((g) => g.rows.map((r) => ({ ...r, group: g.name })));
const groupStart = groups.map((g) => ({ name: g.name, index: cards.findIndex((c) => c.group === g.name) }));
const items = Object.fromEntries(sections.flatMap((s) => s.items.map((it) => [it.id, it])));
const pieceCount = sections.reduce((n, s) => n + s.items.length, 0);
const courseNames: Record<string, string> = {
  'GBDA 210': 'Introduction to UX', 'GBDA 310': 'Advanced User Experience Design and Research', 'GBDA 402': 'Undergraduate Capstone Seminar',
  'GBDA 410': 'Seminar in User Experience Research (Virtual Reality)', 'MSCI 543': 'Analytics and User Experience', 'MSCI 630': 'Human-Computer Interaction',
};
const codesOf = (s?: string) => s?.match(/[A-Z]{4} \d{3}/g) ?? [];
const perCourse = Object.fromEntries(cols.map((c) => [c, cards.filter((r) => r.marks[c]).length]));
const pieceCourses = [...new Set(sections.flatMap((s) => s.items.flatMap((it) => codesOf(it.course))))].sort();
// Start here: four pieces, each showing one of the strategies on the carousel. The tiles are in StartTiles.astro, since
// the home page opens its Teaching resources section with the same four.
// Each section opens with one plain line and a student's own words (quoted as written, from /teaching).
const intro: Record<string, string> = {
  'in-class': 'The work students did in class, quoted as it was handed out.',
  'assignments': 'The bigger pieces: the brief, and the rubric where there was one.',
  'tools': 'Templates, handouts, and forms I used to run teams and to hear from students.',
  'grading': 'How the work was graded, and the rules from my course outlines.',
};
const voice: Record<string, any> = {
  'start': stepComments[0],
  'in-class': comments.find((c) => c.rid === 1175099),
  'assignments': stepComments[2],
  'tools': stepComments[1],
};
// What a piece's text is, where it is not a brief.
const body: Record<string, string> = { 'feedback-form': 'form', 'msci630-discussion': 'handout' };
// A card shows its references short (Jonsson & Svingby, 2007); the full ones are listed under the carousel.
const short = (r: string) => { const [who, year] = [r.slice(0, r.indexOf(' (')), (r.match(/\((\d{4})\)/) ?? [])[1]]; const names = who.split(/,\s*&\s*|,\s+(?=[A-Z][a-z])/).map((x) => x.split(',')[0].trim()).filter((x) => x && !/^[A-Z]\.?(-[A-Z]\.)?$/.test(x)); return `${names.length > 2 ? names[0] + ' et al.' : names.join(' & ')} (${year})`; };
const allRefs = cards.flatMap((c) => c.refs);
const [dept, num] = [(c: string) => c.split(' ')[0], (c: string) => c.split(' ')[1]];
// "See it" names where it goes, for screen readers; the box under an X links to the example only when it is from that course.
const linkTitle = (link: string) => (link === 'policies' ? 'Grading policies' : items[link]?.title ?? '');
const linkCodes = (link: string | null) => (!link ? [] : link === 'policies' ? data.policies.map((p) => p.course) : codesOf(items[link]?.course));
---
<Base title="Teaching resources" pageNav description="What Ali Rizvi uses in each course he teaches, and the real activities, assignments, tools, and rubrics from his courses at the University of Waterloo.">
  <header class="page-head res-hero">
    <p class="label">Resources</p>
    <h1>Teaching resources</h1>
    <div class="grid"><div class="span-8">
      <p class="res-lead">I love <mark>experimenting</mark> with pedagogy to find what works best for <mark>my students</mark>.</p>
      <p>I taught fourteen course sections of six courses at the University of Waterloo between 2021 and 2024. Here are the strategies I use, where I used them, and the real in-class activities, assignments, tools, and rubrics, quoted as students got them.</p>
    </div></div>
  </header>

  <Section label="Start here" id="start">
    <div class="res-intro">
      <p class="res-sub">Short on time? Open these four.</p>
      <div class="res-voice"><Quote comment={voice.start} size="step" /></div>
    </div>
    <StartTiles />
  </Section>

  <Section label="Strategies" id="strategies">
    <div class="carousel" data-carousel>
      <div class="car-bar">
        <div class="car-jump" role="group" aria-label="Jump to a group of strategies">
          {groupStart.map((g) => <button type="button" class="car-tab" data-car-jump={g.index}><span>{g.name}</span></button>)}
        </div>
        <div class="car-nav">
          <p class="car-count" aria-live="polite"><span data-car-pos>1</span> of {cards.length}</p>
          <button type="button" class="car-btn" data-car-prev aria-label="Previous strategies">←</button>
          <button type="button" class="car-btn" data-car-next aria-label="Next strategies">→</button>
        </div>
      </div>
      <ol class="car-track" tabindex="0" aria-label="Strategies, one card each">
        {cards.map((c) => (
          <li class="car-card">
            <div class="car-top">
              <p class="label car-group">{c.group}</p>
              <h3>{c.name}</h3>
              <p class="car-desc">{c.desc}</p>
              {c.refs.length > 0 && <p class="car-refs"><span class="label">Read</span> {c.refs.map(short).join('; ')}</p>}
            </div>
            <p class="car-used"><span class="label">Used in</span> {cols.filter((k) => c.marks[k]).map((k) => <span class="code-chip">{k}</span>)}</p>
            {c.link && <p class="car-link"><a href={`#${c.link}`}>See it<span class="sr">: {linkTitle(c.link)}</span></a></p>}
          </li>
        ))}
      </ol>
      <p class="label refs-label">References</p>
      <ol class="refs-full" aria-label="References">{allRefs.map((r) => <li>{r}</li>)}</ol>
    </div>
  </Section>

  <Section label="Where I used them" id="where">
    <p class="muted strat-note">Each <span class="strat-x-key">X</span> is a course where I used it. Tap or click one to see its source. <span class="strat-keys">With a keyboard, the arrow keys move between them.</span> <a class="skip-inline" href="#find">Skip the table</a></p>
    <ul class="strat-legend">
      {cols.map((c) => <li><span class="code-chip">{c}</span> {courseNames[c]}</li>)}
    </ul>
    <div class="strat-wrap">
      <table class="strat">
        <thead>
          <tr>
            <th scope="col" class="strat-name">Strategy</th>
            {cols.map((c) => <th scope="col" title={courseNames[c]}><span class="strat-dept">{dept(c)}</span> {num(c)}</th>)}
          </tr>
        </thead>
        {groups.map((g, gi) => (
          <tbody>
            <tr class="strat-group"><th scope="colgroup" colspan={cols.length + 1}>{g.name}</th></tr>
            {g.rows.map((r, ri) => (
              <tr>
                <th scope="row" class="strat-name">{r.link ? <a href={`#${r.link}`}>{r.name}</a> : r.name}</th>
                {cols.map((c, ci) => (
                  <td>
                    {r.marks[c] ? (
                      <>
                        <button type="button" class="strat-x" popovertarget={`src-${gi}-${ri}-${ci}`} aria-label={`${r.name}, ${c}: show source`}>X</button>
                        <div popover id={`src-${gi}-${ri}-${ci}`} class="strat-pop">
                          <p class="label">{c} · {r.name}</p>
                          <p>{r.marks[c]}</p>
                          {linkCodes(r.link).includes(c) && <p class="strat-pop-link"><a href={`#${r.link}`}>See it<span class="sr">: {linkTitle(r.link!)}</span></a></p>}
                        </div>
                      </>
                    ) : <span class="sr">{c}: no</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))}
        <tfoot>
          <tr>
            <th scope="row" class="strat-name">Strategies used</th>
            {cols.map((c) => <td class="strat-total">{perCourse[c]}</td>)}
          </tr>
        </tfoot>
      </table>
    </div>
  </Section>

  <div class="res-filter" id="find" data-filter>
    <p class="label" id="find-label">Show pieces from</p>
    <div class="res-filter-row">
      <div class="res-chips" role="group" aria-labelledby="find-label">
        <button type="button" class="res-chip" aria-pressed="true" data-course="all">All courses</button>
        {pieceCourses.map((c) => <button type="button" class="res-chip" aria-pressed="false" data-course={c}>{c}</button>)}
      </div>
      <label class="res-chip res-chip-check"><input type="checkbox" data-rubric-only /> Has a rubric</label>
      <p class="res-count" aria-live="polite" data-count>All {pieceCount} pieces</p>
    </div>
    <p class="res-filter-note">The pieces come from the three courses where I used rubrics, TILT, and specifications grading together. I replaced TA, guest, and client names with [brackets].</p>
  </div>

  {sections.map((s) => (
    <Section label={s.label} id={s.id}>
      <div class="res-intro" data-intro>
        <p class="res-sub">{intro[s.id]}</p>
        {voice[s.id] && <div class="res-voice"><Quote comment={voice[s.id]} size="step" /></div>}
      </div>
      <div class="res-list" data-pieces>
        {s.items.map((it) => <Resource {...it} body={body[it.id]} />)}
      </div>
      {s.id === 'grading' && (
        <div class="res-policies" id="policies" data-policies>
          <h3>Grading policies</h3>
          <p>From my course outlines.</p>
          <div class="res-policy-cols">
            {data.policies.map((p) => (
              <div class="res-policy" data-policy={p.course}>
                <h4><span class="code-chip">{p.course}</span> {p.term}</h4>
                {p.paras.map(([h, t]) => <p><strong>{h}.</strong> {t}</p>)}
              </div>
            ))}
          </div>
        </div>
      )}
    </Section>
  ))}
</Base>

<script>
  const behavior: ScrollBehavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

  // The carousel: the arrows move it a screenful; the group buttons jump to the first card of a group, and the one for
  // the first card on screen is marked, so they also say where you are; the count shows the cards on screen and reaches
  // the last card at the end; the arrows switch off at either end. Without JavaScript the track still scrolls sideways.
  const car = document.querySelector<HTMLElement>('[data-carousel]');
  if (car) {
    const track = car.querySelector<HTMLElement>('.car-track')!;
    const cardsEl = [...track.querySelectorAll<HTMLElement>('.car-card')];
    const pos = car.querySelector<HTMLElement>('[data-car-pos]')!;
    const prev = car.querySelector<HTMLButtonElement>('[data-car-prev]')!;
    const next = car.querySelector<HTMLButtonElement>('[data-car-next]')!;
    const jumps = [...car.querySelectorAll<HTMLButtonElement>('[data-car-jump]')];
    const metrics = () => { const gap = parseFloat(getComputedStyle(track).columnGap) || 0, w = cardsEl[0].getBoundingClientRect().width + gap; return { w, per: Math.max(1, Math.floor((track.clientWidth + gap) / w)) }; };
    const update = () => {
      const { w, per } = metrics();
      const atEnd = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2, atStart = track.scrollLeft <= 2;
      const first = atEnd ? cardsEl.length - per + 1 : Math.round(track.scrollLeft / w) + 1, last = Math.min(cardsEl.length, first + per - 1);
      pos.textContent = per > 1 ? `${first}–${last}` : String(first);
      prev.disabled = atStart; next.disabled = atEnd;
      const here = jumps.filter((b) => Number(b.dataset.carJump) <= first - 1).pop();
      for (const b of jumps) { if (b === here) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current'); }
    };
    prev.addEventListener('click', () => { const { w, per } = metrics(); track.scrollBy({ left: -w * per, behavior }); });
    next.addEventListener('click', () => { const { w, per } = metrics(); track.scrollBy({ left: w * per, behavior }); });
    for (const b of jumps) b.addEventListener('click', () => { const { w } = metrics(); track.scrollTo({ left: w * Number(b.dataset.carJump), behavior }); });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  // Where I used them. The box for an X opens beside it (under it, or above it near the bottom of the screen), and it
  // follows the X if the page scrolls. The X marks are one stop for Tab: the arrow keys move along a row, or up and down
  // a course's column, and Home and End go to the first and last.
  let openPop: HTMLElement | null = null;
  const place = (pop: HTMLElement) => {
    const btn = document.querySelector<HTMLElement>(`[popovertarget="${pop.id}"]`); if (!btn) return;
    const r = btn.getBoundingClientRect(), w = pop.offsetWidth, h = pop.offsetHeight, m = 8;
    let top = r.bottom + 6; if (top + h > innerHeight - m) top = Math.max(m, r.top - h - 6);
    pop.style.left = `${Math.round(Math.min(Math.max(m, r.left + r.width / 2 - w / 2), innerWidth - w - m))}px`;
    pop.style.top = `${Math.round(top)}px`;
  };
  for (const pop of document.querySelectorAll<HTMLElement>('.strat-pop')) {
    pop.classList.add('is-anchored');
    pop.addEventListener('beforetoggle', (e) => { if ((e as any).newState === 'open') pop.classList.add('is-placing'); });
    pop.addEventListener('toggle', (e) => {
      if ((e as any).newState === 'open') { place(pop); pop.classList.remove('is-placing'); openPop = pop; }
      else if (openPop === pop) openPop = null;
    });
  }
  window.addEventListener('scroll', () => { if (openPop) place(openPop); }, { passive: true });
  window.addEventListener('resize', () => { if (openPop) place(openPop); });
  const table = document.querySelector<HTMLTableElement>('table.strat');
  if (table) {
    const xs = [...table.querySelectorAll<HTMLButtonElement>('.strat-x')];
    const col = (b: HTMLElement) => (b.closest('td') as HTMLTableCellElement).cellIndex;
    const row = (b: HTMLElement) => b.closest('tr');
    const stop = (b: HTMLButtonElement) => { for (const x of xs) x.tabIndex = x === b ? 0 : -1; };
    stop(xs[0]);
    table.addEventListener('focusin', (e) => { const b = ((e.target as Element).closest?.('.strat-x') as HTMLButtonElement | null); if (b) stop(b); });
    table.addEventListener('keydown', (e) => {
      const b = ((e.target as Element).closest?.('.strat-x') as HTMLButtonElement | null); if (!b) return;
      const i = xs.indexOf(b); let to: HTMLButtonElement | undefined;
      if (e.key === 'ArrowRight') to = xs[i + 1];
      else if (e.key === 'ArrowLeft') to = xs[i - 1];
      else if (e.key === 'ArrowDown') to = xs.slice(i + 1).find((x) => col(x) === col(b) && row(x) !== row(b));
      else if (e.key === 'ArrowUp') to = xs.slice(0, i).reverse().find((x) => col(x) === col(b) && row(x) !== row(b));
      else if (e.key === 'Home') to = xs[0];
      else if (e.key === 'End') to = xs[xs.length - 1];
      else return;
      e.preventDefault();
      if (to) { openPop?.hidePopover(); stop(to); to.focus(); }
    });
  }

  // Show pieces from: a course, and "has a rubric". While a filter is on, the section intros and any section with
  // nothing left are hidden, so the matches sit together; the grading policies count as part of their course.
  const filter = document.querySelector<HTMLElement>('[data-filter]');
  const pieces = [...document.querySelectorAll<HTMLDetailsElement>('details.res')];
  const lists = [...document.querySelectorAll<HTMLElement>('[data-pieces]')];
  const policyBlock = document.querySelector<HTMLElement>('[data-policies]');
  const policies = [...document.querySelectorAll<HTMLElement>('.res-policy')];
  const courseButtons = [...(filter?.querySelectorAll<HTMLButtonElement>('[data-course]') ?? [])];
  const rubricOnly = filter?.querySelector<HTMLInputElement>('[data-rubric-only]');
  const count = filter?.querySelector<HTMLElement>('[data-count]');
  let course = 'all';
  const apply = () => {
    const rubric = !!rubricOnly?.checked, active = course !== 'all' || rubric;
    let n = 0;
    for (const p of pieces) {
      const ok = (course === 'all' || (p.dataset.courses ?? '').split('|').includes(course)) && (!rubric || p.dataset.rubric === '1');
      p.hidden = !ok; if (ok) n++;
    }
    for (const p of policies) p.hidden = active && (rubric || p.dataset.policy !== course);
    if (policyBlock) policyBlock.hidden = policies.every((p) => p.hidden);
    for (const list of lists) {
      const sec = list.closest('section'); if (!sec) continue;
      const shown = [...list.querySelectorAll<HTMLElement>('details.res')].some((p) => !p.hidden) || (!!policyBlock && sec.contains(policyBlock) && !policyBlock.hidden);
      sec.hidden = !shown;
      const intro = sec.querySelector<HTMLElement>('[data-intro]'); if (intro) intro.hidden = active;
    }
    if (count) count.textContent = !active ? `All ${n} pieces` : n === 0 ? 'No pieces for this filter' : `${n} of ${pieces.length} pieces`;
  };
  for (const b of courseButtons) b.addEventListener('click', () => { course = b.dataset.course!; courseButtons.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); apply(); });
  rubricOnly?.addEventListener('change', apply);
  const reset = () => { course = 'all'; courseButtons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.course === 'all'))); if (rubricOnly) rubricOnly.checked = false; apply(); };

  // A link to one piece (#gbda402-proposal) opens it, from this page or another, even if a filter had hidden it or the
  // same link was clicked before (the hash does not change, so catch the click too). A link to anything else a filter
  // hid (the grading policies) clears the filter first.
  const openPiece = (id: string) => {
    const el = document.getElementById(id);
    if (!(el instanceof HTMLDetailsElement)) return false;
    if (el.closest('[hidden]')) reset();
    el.open = true; el.scrollIntoView(); return true;
  };
  const openFromHash = () => { if (location.hash) openPiece(decodeURIComponent(location.hash.slice(1))); };
  window.addEventListener('hashchange', openFromHash);
  openFromHash();
  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    // Close, at the end of an open piece: shut it and go back to its title.
    const close = t.closest?.('[data-close]');
    if (close) {
      const d = close.closest('details'); if (!d) return;
      const s = d.querySelector('summary')!; d.open = false;
      if (s.getBoundingClientRect().top < 0) s.scrollIntoView(); s.focus(); return;
    }
    const a = t.closest?.('a[href^="#"]'); if (!a) return;
    openPop?.hidePopover();
    const id = decodeURIComponent(a.getAttribute('href')!.slice(1));
    const el = document.getElementById(id); if (!el) return;
    if (el instanceof HTMLDetailsElement && (location.hash === a.getAttribute('href') || el.closest('[hidden]'))) { e.preventDefault(); openPiece(id); history.replaceState(null, '', `#${id}`); }
    else if (!(el instanceof HTMLDetailsElement) && el.closest('[hidden]')) { e.preventDefault(); reset(); el.scrollIntoView(); history.replaceState(null, '', `#${id}`); }
  });
</script>
