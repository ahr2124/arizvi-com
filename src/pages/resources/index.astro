---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('resources')).sort((a, b) => a.data.order - b.data.order);
const groups = [...new Set(items.map((i) => i.data.group))];
---
<Base title="Resources">
  <PageHead label="05 / Resources" title="Resources" lede="Things I keep pointing people to: reading, templates, checklists, and a few files of my own." />
  <section class="section container">
    <ul class="rows">
      {groups.map((g) => items.filter((i) => i.data.group === g).map((i, n) => (
        <li class="grid">
          <p class="label">{n === 0 ? g : ''}</p>
          <div class="body">
            <a class="title" href={i.data.href}>{i.data.title}</a>
            <p>{i.data.note}</p>
          </div>
        </li>
      )))}
    </ul>
  </section>
</Base>
