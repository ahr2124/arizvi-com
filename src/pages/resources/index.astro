---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('resources')).sort((a, b) => a.data.order - b.data.order);
const groups = [...new Set(items.map((i) => i.data.group))];
---
<Base title="Resources">
  <h1>Resources</h1>
  <p class="lede">Things I keep pointing people to: reading, templates, checklists, and a few files of my own.</p>
  {groups.map((g) => (
    <section>
      <h2>{g}</h2>
      <ul class="entries">
        {items.filter((i) => i.data.group === g).map((i) => (
          <li>
            <a href={i.data.href}>{i.data.title}</a>
            <p>{i.data.note}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
