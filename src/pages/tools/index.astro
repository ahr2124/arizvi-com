---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const tools = (await getCollection('tools')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Tools">
  <h1>Tools</h1>
  <p class="lede">Single-purpose pages I've had an AI build for one specific job. Each is a standalone HTML file; open it, use it, close it.</p>
  <ul class="entries">
    {tools.map((t) => (
      <li>
        <a href={t.data.href}>{t.data.title}</a>
        <p>{t.data.useCase} <small>Made with {t.data.madeWith}.</small></p>
      </li>
    ))}
  </ul>
</Base>
