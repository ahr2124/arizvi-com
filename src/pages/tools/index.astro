---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const tools = (await getCollection('tools')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title="Tools">
  <header class="page-head">
    <h1>Tools</h1>
    <div class="grid"><p class="span-8">Single-purpose pages I've had an AI build for one specific job. Each is a standalone HTML file; open it, use it, close it.</p></div>
  </header>
  <section class="section">
    <ul class="rows">
      {tools.map((t) => (
        <li class="grid">
          <p class="label">{fmt(t.data.date)}</p>
          <div class="body">
            <a class="title" href={t.data.href}>{t.data.title}</a>
            <p>{t.data.useCase}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
