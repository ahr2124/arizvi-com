---
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import Exhibits from '../../components/Exhibits.astro';
import Logbook from '../../components/Logbook.astro';
import SectionHead from '../../components/SectionHead.astro';
const hasVideo = fs.existsSync(new URL('../../../public/media/work.mp4', import.meta.url));
const hasPoster = fs.existsSync(new URL('../../../public/media/work.jpg', import.meta.url));
---
<Base title="Work" over>
  <header class:list={['page-head', 'dark', { video: hasVideo }]}>
    {hasVideo && (
      <video class="hero-media" autoplay muted loop playsinline preload="none" poster={hasPoster ? '/media/work.jpg' : undefined} aria-hidden="true">
        <source src="/media/work.mp4" type="video/mp4" />
      </video>
    )}
    {hasVideo && hasPoster && <img class="hero-poster" src="/media/work.jpg" alt="" aria-hidden="true" />}
    <div class="container">
      <p class="label">02 / Work</p>
      <h1 class="page-title">Work</h1>
    </div>
  </header>

  <section class="section container">
    <SectionHead label="01 / Exhibition" title="Case studies" />
    <Exhibits all />
  </section>

  <section class="section container">
    <SectionHead label="02 / Record" title="Logbook" />
    <Logbook />
  </section>
</Base>
