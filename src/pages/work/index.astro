---
import Base from '../../layouts/Base.astro';
import Exhibits from '../../components/Exhibits.astro';
import Logbook from '../../components/Logbook.astro';
import Section from '../../components/Section.astro';
---
<Base title="Work">
  <header class="page-head">
    <h1>Work</h1>
    <div class="grid"><p class="span-8">The research paths in full, then the record of everything I've done, in a logbook.</p></div>
  </header>

  <Section label="Paths">
    <Exhibits all />
  </Section>

  <Section label="Logbook">
    <Logbook />
  </Section>
</Base>
