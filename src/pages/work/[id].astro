---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const entries = (await getCollection('work')).filter((e) => e.body?.trim()).sort((a, b) => a.data.order - b.data.order);
  const featured = entries.filter((e) => e.data.featured);
  return entries.map((entry) => {
    const f = featured.findIndex((x) => x.id === entry.id);
    const next = f === -1 ? featured[0] : featured[(f + 1) % featured.length];
    return { params: { id: entry.id }, props: { entry, next: next && next.id !== entry.id ? next : undefined } };
  });
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const kind = { venture: 'Venture', industry: 'Industry', research: 'Research' }[d.kind];
---
<Base title={d.title} description={d.summary}>
  <article>
    <header class="case-head">
      <p class="label">{d.years} · {d.role} · {kind}</p>
      <h1>{d.title}</h1>
      <div class="grid"><p class="span-8">{d.summary}</p></div>
    </header>
    <div class="case-cover"><Cover entry={entry} eager /></div>
    {d.outcome && (
      <div class="outcome grid">
        <p class="label">Outcome</p>
        <p>{d.outcome}</p>
      </div>
    )}
    <div class="grid">
      <div class="span-8 prose">
        {d.link && <p><a href={d.link} target="_blank" rel="noopener">Visit {d.title}</a></p>}
        <Content />
      </div>
    </div>
    {next && (
      <nav class="next" aria-label="Next project">
        <p class="label">Next</p>
        <a href={`/work/${next.id}/`}>{next.data.title}</a>
      </nav>
    )}
  </article>
</Base>
