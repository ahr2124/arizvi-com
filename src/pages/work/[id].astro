---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { cover } from '../../lib/cover';
export async function getStaticPaths() {
  const entries = (await getCollection('work')).filter((e) => e.body?.trim());
  const featured = entries.filter((e) => e.data.featured).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry) => {
    const i = featured.findIndex((f) => f.id === entry.id);
    const next = i === -1 ? undefined : featured[(i + 1) % featured.length];
    return { params: { id: entry.id }, props: { entry, next: next && next.id !== entry.id ? next : undefined } };
  });
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary}>
  <article class="case">
    <h1>{d.title}</h1>
    <p class="meta soft">{d.years} · {d.role}</p>
    <p class="lede">{d.summary}</p>
    {d.outcome && <p class="outcome">{d.outcome}</p>}
    {d.link && <p><a href={d.link} target="_blank" rel="noopener">Visit {d.title}</a></p>}
    <img class="cover" src={cover(entry)} alt="" width="800" height="600" />
    <div class="prose"><Content /></div>
  </article>
  <nav class="next" aria-label="Next project">
    {next
      ? <p class="soft">Next project: <a href={`/work/${next.id}/`}>{next.data.title}</a></p>
      : <p><a href="/work/">All work</a></p>}
  </nav>
</Base>
