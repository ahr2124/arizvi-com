---
// src/pages/bucknell/anop-102.astro  →  arizvi.com/bucknell/anop-102
// ANOP 102: the term week by week, 4 classes to try and a 5th to read. Not linked from the nav; sends noindex.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import CourseHeader from '../../components/CourseHeader.astro';
import FourSteps from '../../components/FourSteps.astro';
import CourseNav from '../../components/CourseNav.astro';
import PivotDemo from '../../components/PivotDemo.astro';
import BreakevenDemo from '../../components/BreakevenDemo.astro';
import LLMDemo from '../../components/LLMDemo.astro';
import RegressionDemo from '../../components/RegressionDemo.astro';
import LPFigure from '../../components/LPFigure.astro';
import TermFigure from '../../components/TermFigure.astro';
import HandedIn from '../../components/HandedIn.astro';
import ClassPlan from '../../components/ClassPlan.astro';
import { classes } from '../../data/classes';
import { pack } from '../../data/packs/anop-102';
import { course, bucknellColours } from '../../data/bucknell';

const c = course('anop-102');

// The term. Each week: the topic, what the class builds, and the class to try where there is one.
// Four units, each with a figure in the margin.
const units = [
  { n: 1, from: 1, to: 4, weeks: 'Weeks 1-4', name: 'Data you can trust', line: 'Spreadsheets a manager can audit, a cleaned export, and the first brief' },
  { n: 2, from: 5, to: 7, weeks: 'Weeks 5-7', name: 'Models and what-ifs', line: 'Breakeven, Data Tables and Goal Seek, then the midterm' },
  { n: 3, from: 8, to: 10, weeks: 'Weeks 8-10', name: 'Uncertainty', line: 'Expected value, samples, and how a test is run' },
  { n: 4, from: 11, to: 14, weeks: 'Weeks 11-14', name: 'Decisions', line: 'Regression, optimization, and the memo' },
];
const weeks: { w: number; topic: string; build: string; try?: string }[] = [
  { w: 1, topic: 'A spreadsheet someone else can read', build: 'Inputs, formulas and outputs kept apart, named inputs, no numbers typed into formulas. A 1-tab model of a pricing decision.' },
  { w: 2, topic: 'Lookups and cleaning', build: 'Sorting, filtering, XLOOKUP and tidy tables. A sales export, cleaned.' },
  { w: 3, topic: 'Pivot tables and summaries', build: 'Averages, spread and totals by segment, and a 1-page "what happened" brief.', try: 'pivot' },
  { w: 4, topic: 'Charts that answer a question', build: 'Choosing the chart for the claim. 2 charts with a headline each.' },
  { w: 5, topic: 'Breakeven', build: 'How many you have to sell to cover the costs. The model built from a case, with its assumptions in one place.' },
  { w: 6, topic: 'What-if analysis', build: 'Data Tables, scenarios and Goal Seek on the week 5 model.', try: 'breakeven' },
  { w: 7, topic: 'Review and midterm', build: 'A practice case, then the midterm.' },
  { w: 8, topic: 'Expected value', build: 'A forecast that comes with odds, and what to do with it. The class with the chatbot.', try: 'llm' },
  { w: 9, topic: 'Samples and confidence', build: 'An A/B test: how many customers before a real difference shows through the noise, and how sure that leaves you.' },
  { w: 10, topic: 'Testing a claim', build: 'How a trial runs: a control group, the success measure fixed before the data arrives, and the result written up in plain words.' },
  { w: 11, topic: 'Regression', build: 'A line through the data: fitting it, reading the slope and knowing when to doubt it.', try: 'regression' },
  { w: 12, topic: 'Optimization', build: 'The best mix of products within the hours you have, solved with Solver (Excel\'s optimizer), then what 1 more hour is worth, read from the sensitivity report.', try: 'overtime' },
  { w: 13, topic: 'Project workshop', build: 'Teams finish the model and the memo with me at each table. Random draws for the teams whose decision needs them.' },
  { w: 14, topic: 'Team presentations', build: 'The decision memo and the model behind it.' },
];
---
<Base title="ANOP 102" description="ANOP 102, Spreadsheet Modeling & Data Analysis, as Ali Rizvi could teach it at Bucknell - the term week by week, with 4 classes you can try." noindex accent={bucknellColours} up={['/bucknell/', 'All courses']}>
  <CourseHeader course={c} facts={[
    ['Format', '14 weeks, 2 classes of 75 minutes and a lab hour each week'],
    ['Tools', 'Excel. Laptops are open while we build and closed for the debrief.'],
  ]}>
    <p class="practice"><span class="label">A sample</span>ANOP 102 runs in several sections with a shared outline and exams, and those come first. Before teaching it, I would sit in with the professors who teach it now.</p>
  </CourseHeader>

  <FourSteps steps={[
    'Students finish with a model a manager could audit and a 2-page memo. The memo is built in pieces through the term.',
    'Everyone learns the same methods, and each team picks its own decision. Labs are pass or redo, so students who start behind can catch up.',
    'Week 9 comes from a year of A/B tests I ran at a healthcare e-commerce retailer, written up in the chapter <a href="/projects/experimentation/">"A|B Testing, IRL: What Really Works (and Doesn\'t)."</a>',
    'Week 8 opens with midterm feedback. With several sections running, we would sit down each term, compare results and see what worked and what did not.',
  ]} />

  <Section title="Week by week" id="term">
    {units.map((u) => (
      <div class="unit grid">
        <div class="unit-side">
          <TermFigure course="102" unit={u.n} />
          <p class="label">{u.weeks}</p>
          <h3>{u.name}</h3>
          <p class="unit-line">{u.line}</p>
        </div>
        <ul class="rows compact unit-weeks">
          {weeks.filter((x) => x.w >= u.from && x.w <= u.to).map((x) => (
            <li class="grid">
              <div class="label">Week {x.w}</div>
              <div class="body">
                <span class="title">{x.topic}</span>
                <p>{x.build}{x.try && <> <a href={`#${x.try}`}>{x.try === 'overtime' ? 'Read the class below.' : 'Try it below.'}</a></>}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </Section>

  
  <Section title="Cleaning a sales export before the pivot table" id="pivot">
    <ClassPlan plan={classes.pivot} course={c.slug}>
      <p>A coffee cart has 2 campus locations. Which one sold more last week? Below are the till's 12 rows and a pivot table.</p>
      <p>In class, someone reads the answer off the pivot: the Union, $81.50. Then I ask how many locations the cart has. The pivot shows 5, because the library cart is spelled 4 ways, one sale is entered twice and a latte was rung up at $45. We fix each one, and the library cart comes out on top.</p>
    </ClassPlan>
    <PivotDemo />
  </Section>

  <Section title="How wrong can the forecast be?" id="breakeven">
    <ClassPlan plan={classes.breakeven} course={c.slug}>
      <p>A summer taco truck costs $600 a week to run. Tacos cost $3 to make and sell for $8. At last summer's 140 a week, it makes $100. How sure is that?</p>
      <p>A Data Table shows the profit at every price and volume from one formula. I move one assumption at a time, and students watch breakeven shift.</p>
    </ClassPlan>
    <BreakevenDemo />
  </Section>

  <Section title="Using a chatbot's probabilities in a decision" id="llm">
    <ClassPlan plan={classes.llm} course={c.slug}>
      <p>Students already ask chatbots for answers. This class shows what comes back.</p>
      <p>An LLM (a large language model, the engine behind a chatbot) scores every word it could say next and picks one at random, weighted by those scores. At temperature 0, it always picks the most likely word.</p>
      <p>A café asks one for tomorrow's croissant demand, then decides how many to bake. Expected profit is one SUMPRODUCT.</p>
      <p>On the projector I ask it 20 times, and the answer keeps changing. That is when students start asking for the probabilities.</p>
    </ClassPlan>
    <LLMDemo />
  </Section>

  <Section title="Fitting a line to 12 weeks of ad spend" id="regression">
    <ClassPlan plan={classes.regression} course={c.slug}>
      <p>A bike shop spent $0 to $280 a week on Instagram ads for 12 weeks. The ads pay for themselves if $1 brings in more than $2.50 of sales.</p>
      <p>With all 12 weeks in, the slope is $1.70, so the ads lose money. Then someone asks about the orange point, a race weekend. One click removes it, and the ads now pay. The class is about who gets to make that click, and what they write down when they do.</p>
    </ClassPlan>
    <RegressionDemo />
  </Section>

  <Section title="Choosing the product mix with Solver" id="overtime">
    <ClassPlan plan={classes.overtime} course={c.slug}>
      <p>A shop builds 2 bikes. A Commuter earns $120 and takes 3 hours of assembly and 1 of painting. A Trail earns $180 and takes 4 and 3. The crew is paid for 240 assembly hours and 120 painting hours a week, and only 30 Trails sell.</p>
      <p>Most students guess the Trail. Solver says 48 Commuters and 24 Trails. The owner's real question comes next: which overtime to buy.</p>
    </ClassPlan>
    <div class="row-fig"><LPFigure /></div>
  </Section>

  <HandedIn pack={pack} />

  <CourseNav current={c.slug} />
</Base>
