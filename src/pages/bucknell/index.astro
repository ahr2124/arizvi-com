---
// src/pages/bucknell/index.astro  →  arizvi.com/bucknell
// For the Bucknell business analytics search. Not linked from the nav; sends noindex.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import ThresholdDemo from '../../components/ThresholdDemo.astro';

const catalogue = 'https://coursecatalog.bucknell.edu/courses/anop/';

// One row per course. `href` links the title; `sample` is a class from the course.
const courses = [
  {
    id: 'anop-102',
    code: 'ANOP 102',
    meta: 'Core · every term',
    title: 'Spreadsheet Modeling & Data Analysis',
    line: 'Students leave with a model a manager could audit and a 1-page memo that says what to do. Every week adds one piece of that memo.',
    sample: 'Which overtime is worth paying for? A bike shop\'s product mix -> its shadow prices -> a staffing call.',
  },
  {
    id: 'anop-302',
    code: 'ANOP 302',
    meta: 'Elective · full syllabus',
    title: 'Financial Decision Modeling using Spreadsheets',
    href: '/bucknell/anop-302/',
    line: 'Optimisation -> portfolios -> simulation, built on the decision models course I took at Columbia.',
    sample: 'Price an option by simulation and watch it close in on Black-Scholes.',
    sampleHref: '/bucknell/anop-302/#try',
  },
  {
    id: 'anop-330',
    code: 'ANOP 330',
    meta: 'Major requirement',
    title: 'Predictive Analytics: Machine Learning Fundamentals for Business',
    line: 'Every model is a decision tool, so we judge models by what their mistakes cost - and decide who stays in the loop.',
    sample: 'The most accurate model earns nothing. Try it below.',
    sampleHref: '#try',
  },
  {
    id: 'anop-400',
    code: 'ANOP 400',
    meta: 'Capstone · external clients',
    title: 'Business Analytics Practicum',
    line: 'Scope -> data -> model -> recommendation -> delivery. A signed project charter by week 3, and the client in the room at the end.',
    sample: 'I ran the Undergraduate Capstone Seminar at Waterloo this way. Teams delivered working prototypes to external partners every term.',
  },
];

// A first-year load of 6, as a starting point.
const plan = [
  { term: 'Fall 2027', load: ['ANOP 102 (2 sections)', 'ANOP 302'] },
  { term: 'Spring 2028', load: ['ANOP 102', 'ANOP 330', 'ANOP 400'] },
  { term: 'Year 2', load: ['The same core', 'A new elective: human-in-the-loop AI for business decisions'] },
];

const jump = [
  ['#courses', 'Courses'],
  ['#try', 'Try a class'],
  ['/bucknell/anop-302/', 'ANOP 302 syllabus'],
  ['#plan', 'A first year'],
  ['#approach', 'How I teach'],
];
---
<Base title="Bucknell" description="The courses Ali Rizvi would teach in Bucknell's Analytics & Operations Management department, with a draft ANOP 302 syllabus." noindex>
  <header class="page-head">
    <p class="label">Bucknell · Analytics &amp; Operations Management</p>
    <h1>Teaching analytics at Bucknell</h1>
    <p class="tagline">I teach analytics the way I used it in industry: decision -> model -> recommendation.</p>
    <ul class="pills jump" aria-label="On this page">
      {jump.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
    </ul>
  </header>

  <Section label="Courses" id="courses">
    <ul class="rows bk-wide">
      {courses.map((c) => (
        <li class="grid" id={c.id}>
          <div class="label">{c.code}<br />{c.meta}</div>
          <div class="body">
            {c.href
              ? <a class="title" href={c.href}>{c.title} →</a>
              : <span class="title">{c.title}</span>}
            <p>{c.line}</p>
            <p class="sample"><span class="label">{c.code === 'ANOP 400' ? 'Track record' : 'Sample class'}</span>
              {c.sampleHref ? <a href={c.sampleHref}>{c.sample}</a> : c.sample}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="grid"><div class="span-8">
      <p class="muted" style="margin-top: 1.5rem;">I can also take sections of ANOP 203 (Python) and ANOP 270 (Data Visualization). Codes and titles are from the <a href={catalogue} target="_blank" rel="noopener">2026-27 catalogue</a>.</p>
    </div></div>
  </Section>

  <Section label="Try a class" title="The most accurate model earns nothing" id="try">
    <div class="grid"><div class="span-8">
      <p>A 5-minute version of week 7 in ANOP 330. A subscription business has 1,000 customers, and 100 of them will cancel next month. A model ranks every customer by risk. A retention offer keeps anyone who'd cancel, and each customer kept is worth $200. You pick how many customers get the offer.</p>
      <ol>
        <li>Slide to the most accurate setting. Would you deploy it?</li>
        <li>Then show what each setting is worth, and change what the offer costs.</li>
      </ol>
    </div></div>
    <ThresholdDemo />
  </Section>

  <Section label="A first year" id="plan">
    <ul class="path plan-path bk-wide">
      {plan.map((p) => (
        <li>
          <p class="label">{p.term}</p>
          <p>{p.load.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
        </li>
      ))}
    </ul>
    <div class="grid"><div class="span-8">
      <p class="muted" style="margin-top: 1.5rem;">6 courses a year, about 25 students in each. This is a starting point - the core comes first, and I'll fit the rest to what the department needs.</p>
    </div></div>
  </Section>

  <Section label="How I teach" id="approach">
    <div class="grid"><div class="span-8">
      <ol>
        <li><strong>Build the course backwards from the outcome.</strong> Each course ends in work a manager could use, and every week builds toward it.</li>
        <li><strong>Personalize within a defined structure.</strong> Everyone learns the same methods. Each student picks the decision or dataset they apply them to.</li>
        <li><strong>Learn by situational immersion.</strong> Real clients and real constraints wherever I can get them.</li>
        <li><strong>Test the teaching itself.</strong> Mid-term feedback in every course, with changes made before the term ends.</li>
      </ol>
      <p>9 course runs at Waterloo between 2021 and 2024, ~700 students, classes of 40 to 180. More on the <a href="/teaching/">Teaching</a> page.</p>
    </div></div>
  </Section>
</Base>
