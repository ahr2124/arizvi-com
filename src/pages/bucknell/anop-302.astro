---
// src/pages/bucknell/anop-302.astro  →  arizvi.com/bucknell/anop-302
// Draft syllabus for Bucknell's ANOP 302. Not linked from the nav; sends noindex.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';

const facts = [
  ['Course', 'ANOP 302 · Financial Decision Modeling using Spreadsheets · 1 credit'],
  ['Prerequisites', 'ACFM 124 or ACFM 203, and ANOP 102 (or equivalents)'],
  ['Format', '2 sessions a week, 14 weeks, laptops with Excel and Solver in every class'],
  ['Instructor', 'Ali Rizvi, PhD'],
];

const outcomes = [
  'Turn a finance or accounting decision into a spreadsheet model with clear inputs, decisions, constraints and an objective.',
  'Solve linear, integer and nonlinear optimization models, and read the sensitivity output to say what a constraint is worth.',
  'Build and defend a mean-variance portfolio, and measure its risk with value at risk.',
  'Price options with Monte Carlo simulation, and check the answer against a closed-form price.',
  'Write a recommendation a manager can act on, including what would change it.',
];

// Week by week. Each week has a model the class builds together and a lab students finish on their own.
const weeks = [
  { w: '1', topic: 'What a decision model is for', build: 'Model hygiene: inputs, decisions, outputs. A first linear program for a financial plan' },
  { w: '2', topic: 'Short-term financing', build: 'Multi-period cash management: borrow, invest or hold, month by month' },
  { w: '3', topic: 'Sensitivity analysis', build: 'Shadow prices and allowable ranges - what an extra dollar of credit line is worth' },
  { w: '4', topic: 'Multi-period models', build: 'Bond portfolio dedication: meet a stream of liabilities at the lowest cost' },
  { w: '5', topic: 'Integer models', build: 'Capital budgeting and project selection under a budget' },
  { w: '6', topic: 'Accounting applications', build: 'Product mix with contribution margins, and how allocated costs can mislead a decision' },
  { w: '7', topic: 'Review and midterm', build: 'Practice case, then the midterm' },
  { w: '8', topic: 'Nonlinear models', build: 'Mean-variance portfolio optimization (Markowitz)' },
  { w: '9', topic: 'The efficient frontier', build: 'Frontier, constraints that real investors face, and index tracking' },
  { w: '10', topic: 'Risk management', build: 'Simulating portfolio losses and estimating value at risk' },
  { w: '11', topic: 'Monte Carlo fundamentals', build: 'Random draws, distributions, sample size and how fast the answer settles' },
  { w: '12', topic: 'Pricing derivatives', build: 'A European call by simulation, checked against Black-Scholes, then a path-dependent option' },
  { w: '13', topic: 'Hedging', build: 'Foreign exchange exposure hedged with forwards vs. options, compared by simulation' },
  { w: '14', topic: 'Project presentations', build: 'Teams present their decision and the model behind it' },
];

const grading = [
  ['Weekly labs', '25%', 'Small, frequent, low stakes. The lowest one is dropped.'],
  ['Midterm', '20%', 'Optimization: formulate, solve, interpret.'],
  ['Team project', '30%', 'A real financial decision for an organization, modelled and written up as a 2-page memo with the model attached.'],
  ['Final exam', '15%', 'Portfolio, risk and simulation.'],
  ['Exit tickets', '10%', '2 sentences at the end of each class. Graded for completion.'],
];
---
<Base title="ANOP 302 syllabus" description="Draft syllabus for ANOP 302, Financial Decision Modeling using Spreadsheets." noindex>
  <header class="page-head">
    <p class="label"><a href="/bucknell/">Bucknell</a> · Draft syllabus</p>
    <h1>Financial Decision Modeling using Spreadsheets</h1>
    <div class="grid"><div class="span-8">
      <p>ANOP 302 asks students to make financial decisions with models: linear and nonlinear optimization in finance and accounting, portfolio and risk management, and Monte Carlo pricing of derivatives.</p>
      <p>I've built it on the structure of Decision Models and Applications (IEOR E4611), which I took for my MS at Columbia. It runs in the same order: optimization first, then nonlinear models for portfolios, then simulation for risk and pricing. Each week ends with a decision written up for a manager.</p>
    </div></div>
  </header>

  <Section label="At a glance">
    <div class="kv">
      {facts.map(([k, v]) => (<><p class="label">{k}</p><p>{v}</p></>))}
    </div>
  </Section>

  <Section label="What you'll be able to do" id="outcomes">
    <div class="grid"><div class="span-8">
      <ol>{outcomes.map((o) => <li>{o}</li>)}</ol>
    </div></div>
  </Section>

  <Section label="Schedule" id="schedule">
    <ul class="rows">
      {weeks.map((x) => (
        <li class="grid">
          <div class="label">Week {x.w}</div>
          <div class="body">
            <span class="title">{x.topic}</span>
            <p>{x.build}</p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section label="Grading" id="grading">
    <ul class="rows">
      {grading.map(([item, weight, note]) => (
        <li class="grid">
          <div class="label">{item}<br />{weight}</div>
          <div class="body"><p>{note}</p></div>
        </li>
      ))}
    </ul>
  </Section>

  <Section label="How the class runs" id="policies">
    <div class="grid"><div class="span-8">
      <ol>
        <li><strong>Predict first.</strong> Every case opens with a guess before any modelling, and we come back to it once the model is solved.</li>
        <li><strong>Pairs, then the room.</strong> Each model is built in pairs before we debrief it together.</li>
        <li><strong>AI tools.</strong> Allowed for checking formulas and debugging. Submit the prompts with the lab - you stay responsible for every cell.</li>
        <li><strong>Readings.</strong> No required textbook. Recommended: Winston and Albright, <em>Practical Management Science</em>, and Benninga, <em>Financial Modeling</em>.</li>
        <li><strong>Office hours.</strong> 2 slots a week, plus time by appointment. Come with a half-built model - that's the best time to talk.</li>
      </ol>
    </div></div>
  </Section>

  <div class="next">
    <p class="label">Back to</p>
    <a href="/bucknell/">Teaching analytics at Bucknell →</a>
  </div>
</Base>
