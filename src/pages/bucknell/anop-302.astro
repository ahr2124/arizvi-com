---
// src/pages/bucknell/anop-302.astro  →  arizvi.com/bucknell/anop-302
// Draft syllabus for Bucknell's ANOP 302. Not linked from the nav; sends noindex.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import CourseHeader from '../../components/CourseHeader.astro';
import CourseNav from '../../components/CourseNav.astro';
import OptionDemo from '../../components/OptionDemo.astro';
import UnitFigure from '../../components/UnitFigure.astro';
import { course } from '../../data/bucknell';

const c = course('anop-302');

// The short names double as the columns of the grading table.
const outcomes = [
  ['Formulate', 'Turn a finance or accounting decision into a spreadsheet model with clear inputs, decisions, constraints and an objective.'],
  ['Optimise', 'Solve linear, integer and nonlinear models, and read the sensitivity output to say what a constraint is worth.'],
  ['Manage risk', 'Build and defend a mean-variance portfolio, and measure its risk with value at risk.'],
  ['Simulate', 'Price options with Monte Carlo simulation, and check the answer against a closed-form price.'],
  ['Recommend', 'Write a recommendation a manager can act on, including what would change it.'],
];

// Three units. Each week: a model the class builds together, then a lab students finish on their own.
const units: { n: 1 | 2 | 3; weeks: string; name: string; line: string; items: { w: string; topic: string; build: string; try?: boolean }[] }[] = [
  {
    n: 1, weeks: 'Weeks 1-7', name: 'Optimisation', line: 'Linear and integer models for cash, bonds, capital budgets and product mix',
    items: [
      { w: '1', topic: 'From ANOP 102 to finance', build: 'A quick refresher on ANOP 102\'s linear programs, straight onto a financial plan. Model hygiene: inputs, decisions, outputs.' },
      { w: '2', topic: 'Short-term financing', build: 'Multi-period cash management: borrow, invest or hold, month by month.' },
      { w: '3', topic: 'Sensitivity analysis', build: 'Shadow prices and allowable ranges - what an extra dollar of credit line is worth.' },
      { w: '4', topic: 'Multi-period models', build: 'Bond portfolio dedication: meet a stream of liabilities at the lowest cost.' },
      { w: '5', topic: 'Integer models', build: 'Capital budgeting and project selection under a budget.' },
      { w: '6', topic: 'Accounting applications', build: 'Product mix with contribution margins, and how allocated costs can mislead a decision.' },
      { w: '7', topic: 'Review and midterm', build: 'A practice case, then the midterm.' },
    ],
  },
  {
    n: 2, weeks: 'Weeks 8-9', name: 'Portfolios', line: 'Markowitz and the efficient frontier, with the limits real investors face',
    items: [
      { w: '8', topic: 'Nonlinear models', build: 'Mean-variance portfolio optimisation (Markowitz).' },
      { w: '9', topic: 'The efficient frontier', build: 'The frontier, the constraints real investors face, and index tracking.' },
    ],
  },
  {
    n: 3, weeks: 'Weeks 10-14', name: 'Simulation and risk', line: 'Monte Carlo methods, from value at risk to pricing and hedging options',
    items: [
      { w: '10', topic: 'Monte Carlo fundamentals', build: 'Random draws, distributions, sample size and how fast the answer settles.' },
      { w: '11', topic: 'Risk management', build: 'Simulating portfolio losses and estimating value at risk.' },
      { w: '12', topic: 'Pricing derivatives', build: 'A European call by simulation, checked against Black-Scholes, then a path-dependent option.', try: true },
      { w: '13', topic: 'Hedging', build: 'Foreign exchange exposure hedged with forwards vs. options, compared by simulation.' },
      { w: '14', topic: 'Project presentations', build: 'Teams present their decision and the model behind it.' },
    ],
  },
];

// Marks per outcome, in the order above: 1 = assessed, 0.5 = one of these, the team's choice, 0 = not assessed.
const grading = [
  { item: 'Weekly labs', weight: '25%', when: 'Weeks 1-13', note: 'Small, frequent, low stakes. Each ends with a 3-sentence recommendation. The lowest one is dropped.', marks: [1, 1, 1, 1, 1] },
  { item: 'Midterm', weight: '20%', when: 'Week 7', note: 'Optimisation: formulate, solve, interpret.', marks: [1, 1, 0, 0, 0] },
  { item: 'Team project', weight: '30%', when: 'Weeks 4-14', note: 'A financial decision a real organization faces, built from its public filings, or with the organization itself where we can arrange it. Teams form in week 4, pick their decision by week 6, review their model with me in week 10 and present in week 14, with a 2-page memo and the model attached. Peer evaluation adjusts each member\'s mark.', marks: [1, 0.5, 0.5, 0.5, 1] },
  { item: 'Final exam', weight: '15%', when: 'Exam week', note: 'Portfolios, risk and simulation.', marks: [0, 0, 1, 1, 0] },
  { item: 'Exit tickets', weight: '10%', when: 'Every class', note: '2 sentences at the end of each class: what to do, and what would change it. Marked 0, 1 or 2 for whether a manager could act on it.', marks: [0, 0, 0, 0, 1] },
];
const mark = (m: number) => (m === 1 ? '●' : m === 0.5 ? '○' : '');
---
<Base title="ANOP 302 syllabus" description="Draft syllabus for Bucknell's ANOP 302, Financial Decision Modeling using Spreadsheets, by Ali Rizvi." noindex>
  <CourseHeader course={c} crumb="Draft syllabus" facts={[
    ['Format', '1 credit · 3 lecture hours a week for 14 weeks'],
    ['Tools', 'Excel with Solver. Laptops open while we build, closed for the debrief.'],
    ['Instructor', 'Ali Rizvi, PhD'],
  ]}>
    <p>The catalogue describes ANOP 302 as linear and nonlinear optimisation in finance and accounting, portfolio and risk management, and Monte Carlo pricing of derivatives. I built it on Decision Models and Applications (IEOR E4611), the course I took for my MS at Columbia, and it follows the same arc. Every week ends with a decision written up for a manager.</p>
  </CourseHeader>

  <Section label="What you'll be able to do" id="outcomes">
    <div class="grid"><div class="span-8">
      <ol>{outcomes.map(([k, v]) => <li><strong>{k}.</strong> {v}</li>)}</ol>
    </div></div>
  </Section>

  <Section label="Schedule" id="schedule">
    {units.map((u) => (
      <div class="unit grid">
        <div class="unit-side">
          <UnitFigure unit={u.n} />
          <p class="label">{u.weeks}</p>
          <h3>{u.name}</h3>
          <p class="unit-line">{u.line}</p>
        </div>
        <ul class="rows compact unit-weeks">
          {u.items.map((x) => (
            <li class="grid">
              <div class="label">Week {x.w}</div>
              <div class="body">
                <span class="title">{x.topic}</span>
                <p>{x.build}{x.try && <> <a href="#try">Try it below.</a></>}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </Section>

  <Section label="Grading" id="grading">
    <table class="matrix">
      <thead>
        <tr>
          <th class="label" scope="col">Assessment</th>
          {outcomes.map(([k], i) => <th class="o label" scope="col"><span aria-hidden="true">{i + 1}</span><span class="sr">{k}</span></th>)}
        </tr>
      </thead>
      <tbody>
        {grading.map((g) => (
          <tr>
            <td><span class="name">{g.item} · {g.weight}</span><p><span class="label when">{g.when}</span> {g.note}</p></td>
            {g.marks.map((m, i) => (
              <td class="o">
                <span aria-hidden="true">{mark(m)}</span>
                <span class="sr">{m === 1 ? `${outcomes[i][0]}: assessed` : m === 0.5 ? `${outcomes[i][0]}: team's choice` : ''}</span>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    <div class="grid"><div class="span-8">
      <p class="muted" style="margin-top: 1rem;">Columns are the 5 outcomes above. ● assessed · ○ one of these, the team's choice. Every outcome is assessed at least twice.</p>
    </div></div>
  </Section>

  <Section label="How the class runs" id="policies">
    <div class="grid"><div class="span-8">
      <ol>
        <li><strong>Guess first.</strong> Every case opens with a guess before any modelling, and we come back to it once the model is solved.</li>
        <li><strong>Pairs, then the room.</strong> Each model is built in pairs before we debrief it together.</li>
        <li><strong>AI tools.</strong> Allowed for checking formulas and debugging. Submit the prompts with the lab - you stay responsible for every cell.</li>
        <li><strong>Readings.</strong> No required textbook. Recommended: Winston and Albright, <em>Practical Management Science</em>, and Benninga, <em>Financial Modeling</em>.</li>
        <li><strong>Office hours.</strong> 2 slots a week, plus time by appointment. Come with a half-built model - that's the best time to talk.</li>
      </ol>
    </div></div>
  </Section>

  <Section label="Try week 12" title="Price an option by simulation" id="try">
    <div class="grid"><div class="span-8">
      <p>A call option on a $100 stock: strike $100, 1 year to expiry, 20% volatility, 5% interest. Under these assumptions Black-Scholes gives the exact price, so it can check the simulation before we trust simulation with options no formula can price. Simulate stock paths, average the payoffs, and watch the estimate close in.</p>
    </div></div>
    <OptionDemo />
  </Section>

  <CourseNav current={c.slug} />
</Base>
