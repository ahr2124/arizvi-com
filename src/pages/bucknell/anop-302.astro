---
// src/pages/bucknell/anop-302.astro  →  arizvi.com/bucknell/anop-302
// Draft syllabus for Bucknell's ANOP 302. Not linked from the nav; sends noindex.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import CourseHeader from '../../components/CourseHeader.astro';
import CourseNav from '../../components/CourseNav.astro';
import OptionDemo from '../../components/OptionDemo.astro';
import UnitFigure from '../../components/UnitFigure.astro';
import HandedIn from '../../components/HandedIn.astro';
import ClassPlan from '../../components/ClassPlan.astro';
import { classes } from '../../data/classes';
import { pack } from '../../data/packs/anop-302';
import { course } from '../../data/bucknell';

const c = course('anop-302');


// Three units. Each week: a model the class builds together, then a lab students finish on their own.
const units: { n: 1 | 2 | 3; weeks: string; name: string; line: string; items: { w: string; topic: string; build: string; try?: boolean }[] }[] = [
  {
    n: 1, weeks: 'Weeks 1-7', name: 'Optimisation', line: 'Linear and integer models for cash, bonds, capital budgets and product mix',
    items: [
      { w: '1', topic: 'From spreadsheets to finance', build: 'Linear programs from the start, for anyone who has not met them, straight onto a financial plan. Model hygiene: inputs, decisions, outputs.' },
      { w: '2', topic: 'Short-term financing', build: 'Multi-period cash management: borrow, invest or hold, month by month.' },
      { w: '3', topic: 'Sensitivity analysis', build: 'Shadow prices and allowable ranges - what an extra dollar of credit line is worth.' },
      { w: '4', topic: 'Multi-period models', build: 'Bond portfolio dedication: meet a stream of liabilities at the lowest cost.' },
      { w: '5', topic: 'Integer models', build: 'Capital budgeting and project selection under a budget.' },
      { w: '6', topic: 'Accounting applications', build: 'Product mix with contribution margins, and how allocated costs can mislead a decision.' },
      { w: '7', topic: 'Review and midterm', build: 'A practice case, then the midterm.' },
    ],
  },
  {
    n: 2, weeks: 'Weeks 8-9', name: 'Portfolios', line: 'Markowitz and the efficient frontier, with the limits real investors face',
    items: [
      { w: '8', topic: 'Nonlinear models', build: 'Mean-variance portfolio optimisation (Markowitz).' },
      { w: '9', topic: 'The efficient frontier', build: 'The frontier, the constraints real investors face, and index tracking.' },
    ],
  },
  {
    n: 3, weeks: 'Weeks 10-14', name: 'Simulation and risk', line: 'Monte Carlo methods, from value at risk to pricing and hedging options',
    items: [
      { w: '10', topic: 'Monte Carlo fundamentals', build: 'Random draws, distributions, sample size and how fast the answer settles.' },
      { w: '11', topic: 'Risk management', build: 'Simulating portfolio losses and estimating value at risk.' },
      { w: '12', topic: 'Pricing derivatives', build: 'A European call by simulation, checked against Black-Scholes, then a path-dependent option.', try: true },
      { w: '13', topic: 'Hedging', build: 'Foreign exchange exposure hedged with forwards vs. options, compared by simulation.' },
      { w: '14', topic: 'Project presentations', build: 'Teams present their decision and the model behind it.' },
    ],
  },
];

---
<Base title="ANOP 302" description="ANOP 302, Financial Decision Modeling using Spreadsheets, as Ali Rizvi would teach it at Bucknell: the term week by week, and an option to price by simulation." noindex>
  <CourseHeader course={c} facts={[
    ['Format', '1 credit · 14 weeks · 2 classes of 75 minutes a week'],
    ['Tools', 'Excel with Solver. Laptops open while we build, closed for the debrief.'],
  ]}>
    <p>The catalogue describes ANOP 302 as linear and nonlinear optimisation in finance and accounting, portfolio and risk management, and Monte Carlo pricing of derivatives. The arc below is the one that course needs: formulate, then risk, then simulation, with every week ending in a decision written up for a manager. ANOP 350 goes deeper on simulation; weeks 10 to 13 here are the finance applications.</p>
    <p class="practice"><span class="label">From practice</span>At Morgan Stanley I built the team and the products that put data science and AI models in front of compliance staff, and was the firm's voice to 7 regulators on the topic. The deliverable was always a decision someone could defend, with the model behind it. Every week here ends with that memo.</p>
  </CourseHeader>

  
  <Section label="A term, as I'd plan it" title="Week by week" id="term">
    {units.map((u) => (
      <div class="unit grid">
        <div class="unit-side">
          <UnitFigure unit={u.n} />
          <p class="label">{u.weeks}</p>
          <h3>{u.name}</h3>
          <p class="unit-line">{u.line}</p>
        </div>
        <ul class="rows compact unit-weeks">
          {u.items.map((x) => (
            <li class="grid">
              <div class="label">Week {x.w}</div>
              <div class="body">
                <span class="title">{x.topic}</span>
                <p>{x.build}{x.try && <> <a href="#try">Try it below.</a></>}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </Section>

  
  
  
  <Section label="Try a class · Week 12" title="Price an option by simulation" id="try">
    <ClassPlan plan={classes.option} course={c.slug}>
      <p>A call option on a $100 stock: strike $100, 1 year to expiry, 20% volatility, 5% interest. Under these assumptions Black-Scholes gives the exact price, so it can check the simulation before we trust simulation with options no formula can price.</p>
      <p>The widget is the class's first 20 minutes. Each press simulates stock paths a year out, pays each one off at expiry, discounts it and takes the average: that average is the price. The band is the 95% confidence interval around it, and the dashed line is the answer Black-Scholes gives in closed form, which is the check. The question I put to the room before anyone presses anything is how many paths it takes to get within 10 cents, and the guesses are always too low. Class 2 prices an Asian call the same way, and there is no dashed line for that one.</p>
    </ClassPlan>
    <OptionDemo />
  </Section>

  <HandedIn pack={pack} />

  <CourseNav current={c.slug} />
</Base>
