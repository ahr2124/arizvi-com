---
// src/pages/bucknell/anop-330.astro  →  arizvi.com/bucknell/anop-330
// ANOP 330 and two classes to try. Not linked from the nav; sends noindex.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import CourseHeader from '../../components/CourseHeader.astro';
import CourseNav from '../../components/CourseNav.astro';
import ThresholdDemo from '../../components/ThresholdDemo.astro';
import LLMDemo from '../../components/LLMDemo.astro';
import { course } from '../../data/bucknell';

const c = course('anop-330');
---
<Base title="ANOP 330" description="ANOP 330, Machine Learning Fundamentals for Business, as Ali Rizvi would teach it at Bucknell - with 2 classes you can try." noindex>
  <CourseHeader course={c} />

  <Section label="Try a class · Week 7" title="The most accurate model earns nothing" id="try">
    <div class="grid"><div class="span-8">
      <p>Your subscription business has 1,000 customers. Next month 100 of them will cancel - you just don't know which 100. A model gives every customer a risk score.</p>
      <p>You can send a retention offer. It costs $20 and keeps anyone who was about to cancel, and each customer kept is worth $200. How many of your riskiest customers should get it?</p>
      <p>Start at nobody - that's the most accurate model. Then slide right and watch the money.</p>
    </div></div>
    <ThresholdDemo />
  </Section>

  <Section label="Try a class · Week 11" title="An LLM gives you odds" id="llm">
    <div class="grid"><div class="span-8">
      <p>An LLM doesn't look an answer up. It scores every word it could say next, turns the scores into odds, and picks one at random by those odds. Temperature sets how much it gambles: at 0 it always picks the favourite.</p>
      <p>Here a café asks one for tomorrow's croissant demand, then has to decide how many to bake.</p>
    </div></div>
    <LLMDemo />
  </Section>

  <CourseNav current={c.slug} />
</Base>
