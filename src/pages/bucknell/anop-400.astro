---
// src/pages/bucknell/anop-400.astro  →  arizvi.com/bucknell/anop-400
// ANOP 400 and how its term runs. Not linked from the nav; sends noindex.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import CourseHeader from '../../components/CourseHeader.astro';
import CourseNav from '../../components/CourseNav.astro';
import Gantt from '../../components/Gantt.astro';
import { course } from '../../data/bucknell';

const c = course('anop-400');

// The ANOP 400 term, week by week.
const term = [
  { label: 'Scope', bars: [[1, 3]] as [number, number][] },
  { label: 'Data and discovery', bars: [[4, 6]] as [number, number][] },
  { label: 'Modelling', bars: [[7, 10]] as [number, number][] },
  { label: 'Recommendation', bars: [[11, 13]] as [number, number][] },
  { label: 'Delivery', bars: [[14, 14]] as [number, number][] },
  { label: 'With the client', marks: [{ w: 1 }, { w: 3 }, { w: 8 }, { w: 14 }] },
  { label: 'Team stand-ups', ticks: Array.from({ length: 14 }, (_, i) => i + 1) },
];
---
<Base title="ANOP 400" description="ANOP 400, the Business Analytics Practicum, as Ali Rizvi would run it at Bucknell." noindex>
  <CourseHeader course={c} facts={[['Track record', 'I ran the Undergraduate Capstone Seminar at Waterloo this way. Teams delivered working prototypes to external partners every term.']]} />

  <Section label="The term" title="Week by week" id="sample">
    <Gantt title="The ANOP 400 term, week by week" weeks={14} rows={term}
      caption="With the client: kick-off (week 1), signed charter (3), check-in (8), final presentation (14). Every team gets a 15-minute stand-up each week." />
  </Section>

  <CourseNav current={c.slug} />
</Base>
