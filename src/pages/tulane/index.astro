---
// src/pages/tulane/index.astro  →  arizvi.com/tulane
// For the Tulane Freeman search (Professor of Practice, Management Science - Information Systems): how I teach,
// the 3 courses I'd start with (the core course and the 2 fall courses the master's requires, 1 of them the information
// systems course), the ones I'd share with the colleagues who teach them, and one class to try.
// Not linked from the nav; sends noindex. Codes, titles, prerequisites and the master's plan are from Tulane's 2026-27 catalogue.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import ClassPlan from '../../components/ClassPlan.astro';
import ThresholdDemo from '../../components/ThresholdDemo.astro';
import { classes } from '../../data/classes';
import { arrows } from '../../data/bucknell';

const catalogue = 'https://catalog.tulane.edu/courses/mgsc/';
// Numbers and course codes stay on the same line as the word after them (as on /bucknell).
const keep = (s: string) => s.replace(/(\d|[A-Z]{4}) (?=\w)/g, '$1\u00a0');

const principles = [
  ['Build the course backwards from the outcome.', 'Each course ends in work a manager could use, and every week builds toward it.'],
  ['Personalize within a defined structure.', 'Everyone learns the same methods. Each student picks the decision or dataset they apply them to.'],
  ['Learn on real problems.', 'Real sponsors and real constraints wherever I can get them.'],
  ['Test the teaching itself.', 'Mid-term feedback in every course, with changes made before the term ends.'],
];

const courses = [
  {
    code: 'MGSC 3010',
    where: 'BSM core',
    title: 'Introduction to Business Analytics',
    line: 'Excel models -> optimisation -> simulation, and every model ends in a short memo a manager could act on.',
    who: 'BSM students, after INFO 1010 and MGSC 3005 (or MATH 1230).',
  },
  {
    code: 'MGSC 7100',
    where: 'Required in the master\'s · fall',
    title: 'SQL Database Fundamentals and Business Intelligence',
    line: 'Tables -> keys -> queries -> a database application each team builds and demos. It\'s the information systems course I\'d teach from practice. At Morgan Stanley I prototyped and deployed data models in SQL and, with partners in IT, implemented a Hadoop-based data lake. On Alexa at Amazon I owned services across AWS, APIs and MLOps.',
    who: 'Master of Business Analytics and AI students, and seniors on the 4+1.',
  },
  {
    code: 'MGSC 7340',
    where: 'Required in the master\'s · fall',
    title: 'Web Analytics',
    line: 'Search and acquisition -> funnels -> instrumentation -> A/B tests -> a ship-or-kill call, with the analysis in Python, taught from a year of live experiments I ran inside an e-commerce retailer.',
    who: 'Master of Business Analytics and AI students, and seniors on the 4+1.',
    sample: { href: '/work/experimentation/', text: 'The experiments it\'s taught from\u00a0→' },
  },
];

// Courses colleagues teach now. I'd take a section of either, on the outline it already runs on.
const shared = [
  {
    code: 'MGSC 4690',
    where: 'Business Analytics and AI certificate',
    title: 'AI for Business',
    line: 'Students understand the technology, then build models that can thoughtfully answer business problems. I\'d take MGSC 7350, its graduate twin, too.',
    sample: { href: '#try', text: 'Try a class I\'d bring to it below' },
  },
  {
    code: 'MGSC 7870',
    where: 'Required in the master\'s · spring',
    title: 'Business Analytics Projects',
    line: 'Scope -> data -> model -> recommendation -> delivery, with a charter the sponsor signs by week 3 and the sponsor in the room at the end. I can bring sponsors from the 40+ portfolio companies I work across at AMJ Capital, and I wouldn\'t grade a team working for a company the fund or I hold a stake in.',
  },
];

---
<Base title="Tulane" description="The courses Ali Rizvi would teach in the Management Science area at Tulane's Freeman School of Business, and how he teaches them." noindex>
  <header class="page-head">
    <div class="intro-grid">
      <div class="text">
        <p class="label">Tulane · Freeman School of Business · Management Science</p>
        <h1>Teaching analytics and information systems at Freeman</h1>
      </div>
      <div class="photo"><img src="/media/headshot.jpg" alt="Ali Rizvi" width="400" height="500" /></div>
    </div>
  </header>

  <Section label="How I teach" id="approach">
    <ol class="principles">
      {principles.map(([head, line]) => <li><strong>{head}</strong> {line}</li>)}
    </ol>
    <p class="muted principles-note">14 course sections at Waterloo between 2021 and 2024, ~700 students, up to 4 sections and 180 students in a term. I taught data analytics and statistics inside MSCI 630, GBDA 210 and MSCI 543. MSCI 543 ran entirely in Python, and MSCI 630 had modules in Python and Tableau. GBDA 402, the capstone seminar, ran on live client projects with external partners. The stories in class come from the work: Alexa at Amazon, a year of A/B tests inside a healthcare e-commerce retailer, compliance models at Morgan Stanley, and the portfolio companies at AMJ Capital. More on the <a href="/teaching/">Teaching</a> page.</p>
  </Section>

  <Section label="Where I'd start" id="courses">
    <div class="grid"><div class="span-8">
      <p>{keep('My letter names MGSC 4320, MGSC 4690 and MGSC 7520, the courses closest to my own work. If the area needs its required courses covered first, this is where I\'d start.')}</p>
    </div></div>
    <ul class="rows bk-wide">
      {courses.map((c) => (
        <li class="grid">
          <div class="label">{c.code}<br />{c.where}</div>
          <div class="body">
            <span class="title">{c.title}</span>
            <p>{arrows(c.line)}</p>
            <p class="who"><span class="label">Students</span>{keep(c.who)}</p>
            {c.sample && <p class="sample"><a href={c.sample.href}>{c.sample.text}</a></p>}
          </div>
        </li>
      ))}
    </ul>
    <div class="grid"><div class="span-8">
      <p style="margin-top: 1.5rem;">Tools I work in: Python first, then SQL, Tableau and Excel with Solver.</p>
      <p class="muted">MGSC 7100 and MGSC 7340 are both required in the master's fall term. Whatever outline each of the 3 runs on comes first. Codes, titles and prerequisites are from the <a href={catalogue} target="_blank" rel="noopener">2026-27 catalogue</a>.</p>
    </div></div>
  </Section>

  <Section label="Alongside colleagues" id="shared">
    <div class="grid"><div class="span-8">
      <p>These 2 are taught by people who'd be my colleagues. I'd take a section of either on the outline it already runs on.</p>
    </div></div>
    <ul class="rows bk-wide">
      {shared.map((c) => (
        <li class="grid">
          <div class="label">{c.code}<br />{c.where}</div>
          <div class="body">
            <span class="title">{c.title}</span>
            <p>{arrows(c.line)}</p>
            {c.sample && <p class="sample"><a href={c.sample.href}>{c.sample.text}</a></p>}
          </div>
        </li>
      ))}
    </ul>
    <div class="grid"><div class="span-8">
      <p class="muted" style="margin-top: 1.5rem;">{keep('I can also take MGSC 4320, MGSC 4790 and MGSC 7520 (the last 2 are the Python courses), MGSC 4590 and MGSC 3005.')}</p>
    </div></div>
  </Section>

  <Section label="Try a class" title="The most accurate cutoff earns nothing" id="try">
    <ClassPlan plan={classes.threshold} course="mgsc-4690" pack={false}>
      <p>Your subscription business has 1,000 customers. Next month 100 of them will cancel - you just don't know which 100. A model gives every customer a risk score.</p>
      <p>You can send a retention offer. It costs $20, and each customer it keeps is worth $200. To keep the arithmetic simple, say it keeps everyone it reaches who was about to cancel. How many of your riskiest customers should get it?</p>
      <p>This is a class from the machine learning term I've planned; at Freeman it would fit a session of MGSC 4690 or MGSC 4320. The widget is 20 minutes of it. The grid is next month, 1 square a customer, in the order the model ranked them, riskiest first. The slider is the business decision: how far down the list the offers go. Every position on it has an accuracy and a dollar value, and the class is about which of the 2 a manager should care about. Then I change what an offer costs, and the right answer moves while the accuracy stays put.</p>
    </ClassPlan>
    <ThresholdDemo />
  </Section>
</Base>
