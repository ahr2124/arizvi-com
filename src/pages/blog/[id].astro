---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={post.data.title} description={post.data.summary}>
  <article class="prose">
    <h1>{post.data.title}</h1>
    <p class="soft"><time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time></p>
    <Content />
  </article>
</Base>
