---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
const scholar = 'https://scholar.google.com/citations?user=ngAHmhEAAAAJ&hl=en&oi=ao';
---
<Base title="Research">
  <header class="page-head">
    <h1>Research</h1>
    <div class="grid"><p class="span-8">Applied HCI: how designed systems land in real institutions — schools, care homes, field sites — and what that means for method.</p></div>
  </header>

  <Section label="Current" title="Papers in flight">
    <ul>
      <li>Access strategies compounding and transferring across field sites — qualitative methods paper, GI 2026.</li>
      <li>Stigma-aware dashboards and child-wellbeing communication in Indian schools.</li>
      <li>Two touchscreen games built for Pravasi Bharatiya Divas 2025 — targeting ACM ISS 2026.</li>
    </ul>
  </Section>

  <Section label="Doctorate" title="Doctoral work">
    <p>PhD in Management Science and Engineering, University of Waterloo. (Two or three sentences on the thesis and its contribution.)</p>
  </Section>

  <Section label="Community" title="Service">
    <ul>
      <li>Reviewer, ACM CUI 2026.</li>
    </ul>
  </Section>

  <section class="section">
    <ul class="rows">
      <li class="grid">
        <p class="label">Publications</p>
        <div class="body"><a class="title" href={scholar} target="_blank" rel="noopener">Full list on Google Scholar</a></div>
      </li>
    </ul>
  </section>
</Base>
