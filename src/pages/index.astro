---
import Base from '../layouts/Base.astro';
import Exhibits from '../components/Exhibits.astro';
import Section from '../components/Section.astro';
const email = 'ali.rizvi@uwaterloo.ca';
const news = [
  ['Oct 2026', 'Keynote, 6th International SDG Conference, Chitrakoot: "Who Consulted the Village?"'],
  ['2026', 'Published at ACM Interactive Health 2026: "Embed, don\'t isolate", on stigma-sensitive parent dashboards.'],
  ['2026', 'Chapter "A/B Testing IRL" forthcoming from Springer.'],
  ['Oct 2025', 'PhD defended, University of Waterloo.'],
];
---
<Base title="Ali Rizvi">
  <section class="intro">
    <div class="intro-grid">
      <div class="text">
        <ul class="pills status" aria-label="Status">
          <li>HCI researcher</li>
          <li>PhD, University of Waterloo, 2025</li>
        </ul>
        <h1>Ali Rizvi</h1>
        <p class="tagline">Technology for the other eighty percent.</p>
        <ul>
          <li>I design and study AI and interactive systems for the people they were not built for. The assumptions underneath them — a large stable room, a good connection, a language the model was trained on, little at stake when the system is wrong — run out somewhere small, moving, or improvised: a van, a classroom in Hyderabad, a card table.</li>
          <li>Most of the AI arriving in mental health is something you talk to. I work the other direction: diagnostic tools a child takes an active part in, and reports a parent can act on.</li>
          <li>I build the systems as part of the research. One became a company, one became a lab with a school in it.</li>
          <li>Published at CHI, Graphics Interface, CHI PLAY, and ACM Interactive Health.</li>
          <li>Seven years in product and analytics before the doctorate: the orchestration layer of Amazon Alexa; data and AI for compliance at Morgan Stanley.</li>
          <li>Nine courses in UX and HCI at Waterloo, about 700 students.</li>
          <li>Independent researcher; on the academic job market for 2027.</li>
        </ul>
        <p class="label"><a href="/cv.pdf">CV (PDF)</a> &nbsp;·&nbsp; <a href="/projects/">Research statement</a> &nbsp;·&nbsp; <a href={`mailto:${email}`}>{email}</a></p>
      </div>
      <div class="photo"><img src="/media/headshot.jpg" alt="Ali Rizvi" width="400" height="500" /></div>
    </div>
  </section>

  <Section label="Applied research" title="Where the research went">
    <div class="grid"><p class="span-8">Reaching the other eighty percent needs a new way of working. Each of these began as a question in the PhD, became a study and a paper, then an artefact, and then something that keeps the field site open: a company, a lab with a school in it, a thesis. The same path, with the same people, is what I'd bring to a department.</p></div>
    <Exhibits />
  </Section>

  <Section label="News">
    <ul class="news">
      {news.map(([d, t]) => <li><p class="label">{d}</p><p>{t}</p></li>)}
    </ul>
  </Section>
</Base>
