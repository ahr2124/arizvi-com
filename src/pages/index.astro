---
import Base from '../layouts/Base.astro';
import Exhibits from '../components/Exhibits.astro';
import Section from '../components/Section.astro';
const email = 'ali.rizvi@uwaterloo.ca';
const news = [
  ['Oct 2026', 'Keynote, 6th International SDG Conference, Chitrakoot: "Who Consulted the Village?"'],
  ['2026', 'Published at ACM Interactive Health 2026: "Embed, don\'t isolate", on stigma-sensitive parent dashboards.'],
  ['2026', 'Chapter "A/B Testing IRL" forthcoming from Springer.'],
  ['Oct 2025', 'PhD defended, University of Waterloo.'],
];
---
<Base title="Ali Rizvi">
  <section class="intro">
    <div class="intro-grid">
      <div class="text">
        <h1>Ali Rizvi</h1>
        <p class="tagline">I am an educator and researcher.</p>
        <ul>
          <li>I'm an HCI researcher (PhD, University of Waterloo, 2025). I work on AI and interactive systems for the 80% of people they weren't built for: people using a second language, on a bad connection, in a small or moving room, with a lot to lose if the system gets it wrong.</li>
          <li>Most AI in mental health right now is a chatbot you talk to. I work on assessment and reporting: students take wellbeing assessments (IRT, Indian norms), and their parents get a dashboard that shows wellbeing next to strengths, interests and academics.</li>
          <li>I build the systems as part of the research. One became a company (Scramble Deck). One became my research lab (Bodhika Labs), with a partner school in Hyderabad.</li>
          <li>I've published at CHI, Graphics Interface, CHI PLAY and ACM Interactive Health.</li>
          <li>Before the PhD I spent ~7 years in product and analytics. I was a senior technical PM on the orchestration layer of Amazon Alexa, and I built the data science and AI products for compliance at Morgan Stanley.</li>
          <li>I've taught 9 courses in UX and HCI at Waterloo (~700 students).</li>
          <li>I'm an independent researcher right now, and on the academic job market for 2027.</li>
        </ul>
        <p class="label"><a href="/projects/">Research statement</a> &nbsp;·&nbsp; <a href={`mailto:${email}`}>{email}</a></p>
      </div>
      <div class="photo"><img src="/media/headshot.jpg" alt="Ali Rizvi" width="400" height="500" /></div>
    </div>
  </section>

  <Section title="Research output">
    <div class="grid"><p class="span-8">Each project goes the same way: a question in the PhD → a study and an output (an artefact, a system) → something that keeps the work going after the paper is out.</p></div>
    <Exhibits />
  </Section>

  <Section label="News">
    <ul class="news">
      {news.map(([d, t]) => <li><p class="label">{d}</p><p>{t}</p></li>)}
    </ul>
  </Section>
</Base>
