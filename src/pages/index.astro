---
import Base from '../layouts/Base.astro';
import Exhibits from '../components/Exhibits.astro';
import Logbook from '../components/Logbook.astro';
import Section from '../components/Section.astro';
---
<Base title="Ali Rizvi">
  <section class="intro">
    <p class="label">Product · Research · Flight</p>
    <h1>I build products and study how people use them.</h1>
    <div class="grid">
      <p class="span-8">I'm Ali Rizvi. I've been a product manager at Amazon Alexa, a director at Morgan Stanley, and a consultant at PwC and EY, and in between I did a PhD in human-computer interaction at Waterloo. Today I run a few ventures, publish applied HCI research, and fly whenever I can.</p>
    </div>
  </section>

  <Section label="Selected work" title="Work">
    <Exhibits />
  </Section>

  <Section label="Logbook">
    <Logbook />
  </Section>

  <Section label="About">
    <div class="grid">
      <div class="span-8">
        <p>I live in Vancouver, with a second base in Hyderabad. I'm an industrial engineer by training (NIT Jalandhar), with a master's from Columbia and a doctorate from Waterloo, where I also taught UX and HCI for three years.</p>
        <p>I hold commercial pilot licences from Transport Canada and the FAA, an FAA instrument rating, and a ground instructor certificate. I race triathlon, dive, and take photographs when I travel. I sit on the board of a venture fund and used to be treasurer of a sailing club.</p>
        <p><a href="/cv.pdf">Download my CV (PDF)</a></p>
      </div>
    </div>
  </Section>
</Base>
