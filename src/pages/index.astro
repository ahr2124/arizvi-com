---
import Base from '../layouts/Base.astro';
import Exhibits from '../components/Exhibits.astro';
import Logbook from '../components/Logbook.astro';
import Section from '../components/Section.astro';
---
<Base title="Ali Rizvi">
  <section class="intro">
    <p class="label">Research · Product · Teaching</p>
    <h1>My teams and I build cool things.</h1>
    <div class="grid">
      <p class="span-8">I'm an HCI researcher with a PhD from the University of Waterloo. I study how designed systems land in real institutions, mostly schools and care settings, and I build the systems as part of the research. Before the doctorate I spent seven years in product and analytics, most recently at Amazon Alexa.</p>
    </div>
  </section>

  <Section label="Selected work" title="Work">
    <Exhibits />
  </Section>

  <Section label="Logbook">
    <Logbook />
  </Section>
</Base>
