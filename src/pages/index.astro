---
import Base from '../layouts/Base.astro';
import Exhibits from '../components/Exhibits.astro';
import Logbook from '../components/Logbook.astro';
import Section from '../components/Section.astro';
---
<Base title="Ali Rizvi">
  <section class="intro">
    <p class="label">Product · Research · Flight</p>
    <h1>Ali Rizvi builds products and studies how people use them.</h1>
    <div class="grid">
      <p class="span-8">Product leader and CTO with an HCI doctorate. I've shipped at Amazon Alexa, run technology for a family group of companies, and now split my time between a few ventures and applied research. I also fly.</p>
    </div>
  </section>

  <Section label="Selected work" title="Work">
    <Exhibits />
  </Section>

  <Section label="Logbook">
    <Logbook />
  </Section>

  <Section label="About">
    <div class="grid">
      <div class="span-8">
        <p>I live in Vancouver's West End, having moved from Hyderabad in 2026. My path runs through management consulting, Morgan Stanley, Affinity, and Amazon Alexa, then a mid-career PhD in Management Science and Engineering at Waterloo with an HCI thesis. I hold an MS in Engineering Management Systems from Columbia.</p>
        <p>Outside work I hold a Commercial Pilot Licence (Transport Canada and FAA, since 2019), race triathlon, and take photographs when I travel.</p>
        <p><a href="/cv.pdf">Download my CV (PDF)</a></p>
      </div>
    </div>
  </Section>
</Base>
