---
import Base from '../layouts/Base.astro';
import Exhibits from '../components/Exhibits.astro';
import Section from '../components/Section.astro';
const email = 'ali.rizvi@uwaterloo.ca';
const news = [
  ['Oct 2026', 'Keynote, 6th International SDG Conference, Chitrakoot: "Who Consulted the Village?"'],
  ['2026', 'Proteus Card Deck full paper in revision for ACM ISS 2027, with Oliver Schneider and Mark Hancock.'],
  ['2026', 'Published at ACM Interactive Health 2026: "Embed, don\'t isolate", on stigma-sensitive parent dashboards.'],
  ['2026', 'Chapter "A/B Testing IRL" forthcoming from Springer.'],
  ['Oct 2025', 'PhD defended, University of Waterloo.'],
];
---
<Base title="Ali Rizvi">
  <section class="intro">
    <div class="intro-grid">
      <div class="text">
        <ul class="pills status" aria-label="Status">
          <li>HCI researcher</li>
          <li>PhD, University of Waterloo, 2025</li>
        </ul>
        <h1>Ali Rizvi</h1>
        <p class="tagline">Technology for the other eighty percent.</p>
        <ul>
          <li>I'm an HCI researcher. I design and study AI and interactive systems for the 80% of people they were never built for - the wrong language, a bad connection, a small or moving room, and a lot to lose if the system gets it wrong.</li>
          <li>Most AI in mental health right now is a chatbot you talk to. I'm going the other way: diagnostic tools a child actually takes part in, and reports that give a parent something to do next.</li>
          <li>I build the systems as part of the research. One turned into a company (Scramble Deck), one turned into independent research with a partner school in Hyderabad (Bodhika Labs).</li>
          <li>Published at CHI, Graphics Interface, CHI PLAY and ACM Interactive Health.</li>
          <li>Before the PhD: ~7 years in product and analytics. Senior technical PM on the orchestration layer of Amazon Alexa; built the data science and AI products for compliance at Morgan Stanley.</li>
          <li>Taught 9 courses in UX and HCI at Waterloo, ~700 students.</li>
          <li>Independent researcher right now, and on the academic job market for 2027.</li>
        </ul>
        <p class="label"><a href="/cv.pdf">CV (PDF)</a> &nbsp;·&nbsp; <a href="/projects/">Research statement</a> &nbsp;·&nbsp; <a href={`mailto:${email}`}>{email}</a></p>
      </div>
      <div class="photo"><img src="/media/headshot.jpg" alt="Ali Rizvi" width="400" height="500" /></div>
    </div>
  </section>

  <Section title="Research output">
    <div class="grid"><p class="span-8">Every project has a natural progression: a question in the PhD, then a study and an output (an artefact, a system), then something that keeps the work going after the paper is out.</p></div>
    <Exhibits />
  </Section>

  <Section label="News">
    <ul class="news">
      {news.map(([d, t]) => <li><p class="label">{d}</p><p>{t}</p></li>)}
    </ul>
  </Section>
</Base>
