---
// ANOP 102 laid out the way it would sit in Moodle, around one class (Ali, 17 Nov 2026: "For Bucknell, focus on
// building out a mock LMS around the one lesson that I am teaching"). What a student sees in a Moodle course: a
// breadcrumb, the Course, Participants and Grades tabs, the course index down the side, and the course page itself: a
// General section, then one section per week with its activities, each with its type, its dates and its completion
// mark. On /bucknell it opens on class 2, the lesson itself; the course page is a tab away. Week 11 is open and built out in full (before class, class 1, class 2, after class), and its pieces open up:
// the ToolPak page, the check (a quiz you can take), class 2 (the plan, with the 30 minutes taught on the campus visit
// marked, and the regression to try), and lab 11 (its brief, rubric and submission status). The other 13 weeks come
// from the course pack, closed, with their labs and project pieces.
// No logos, icons or Moodle colours: black on white, the one typeface, and the section colour for where you are,
// what is done and a rubric's best level.
// The mock is called Meow-Dle (Ali, 19 Nov 2026: "lets name the fake moodle meow-dle", then "just leave Meow-Dle").
// The name sits in text across the top, where Moodle shows a site's name. On /bucknell the shell is the whole page (no
// title or lede above it), so the name is the page's h1, the panel titles are h2 and their subheads h3; each keeps the
// look it had as h3 and h4. The shell starts where a page title would (the page head's 4rem).
// Without JavaScript every panel shows, one after another, and the tabs and the course index jump to each. With it,
// one panel shows at a time, the breadcrumb follows, and the address keeps the panel (/bucknell/#mdl-class2), so a
// link can open one. On a tablet or a phone the course index is left out, as Moodle closes its drawer, and the weeks
// are on the course page. In print every panel shows.
// The content is in src/data/bucknell102.ts and src/data/packs/anop-102.ts. The first version of this shell was made
// for ANOP 270 on 13 Nov 2026 and never published; /tulane's CourseShell.astro is the same idea in Canvas.
import SongsDemo from './SongsDemo.astro';
import { pack } from '../data/packs/anop-102';
import { course, now, moment, week11, announcements, people, check, toolpak, class2, lab11, grades, gradesNote, type Activity, type Label } from '../data/bucknell102';

// start: the panel that opens when the address names none (on /bucknell, the class itself).
interface Props { start?: string }
const { start = 'mdl-course' } = Astro.props;
const tabs = [['mdl-course', 'Course'], ['mdl-participants', 'Participants'], ['mdl-grades', 'Grades']];
const general: Activity[] = [
  { type: 'Forum', title: 'Announcements', href: '#mdl-announcements' },
  { type: 'Page', title: 'Syllabus', href: '#mdl-syllabus' },
  { type: 'Forum', title: 'Course questions', text: 'Questions about the course go here, so that the answer helps everyone.' },
];

// Every week but week 11, from the pack: the check before class 1, the week's lab, the midterm, the project pieces.
const piece = (memo: string) => {
  const m = memo.match(/^The ([\w-]+(?: [\w-]+)?) piece/);
  return m ? `Project: the ${m[1]} piece` : memo.startsWith('The recommendation') ? 'Project: the memo and presentation' : 'Project';
};
const weeks = pack.weeks.map((w) => {
  if (w.w === now) return { w: w.w, topic: w.topic, items: week11 };
  const done = w.w < now;
  const items: Activity[] = [];
  // The pack's pre-work: a video and a check most weeks, a reading and a check in week 5, a check alone in week 7,
  // nothing in weeks 13 and 14.
  if (w.before && !/^Nothing\.? (Sleep|new\. Bring)/.test(w.before)) items.push({ type: 'Quiz', title: w.before.startsWith('Video') ? 'Video and check, before class 1' : w.before.startsWith('Read the') ? 'Reading and check, before class 1' : 'Check, before class 1', done });
  if (w.w === 7) items.push({ type: 'Quiz', title: 'Midterm (in class, 75 minutes)', done });
  const lab = pack.labs.find((l) => l.n === w.w);
  if (lab) items.push({ type: 'Assignment', title: `Lab ${lab.n}: ${lab.title}`, note: `Due ${lab.due}`, done });
  if (w.memo) items.push({ type: 'Assignment', title: piece(w.memo), done });
  if (w.w === 14) items.push({ type: 'Assignment', title: 'Reflection (one page)', done });
  return { w: w.w, topic: w.topic, items };
});
const isLabel = (i: Activity | Label): i is Label => 'label' in i;
// The pack's grading rows point at a rubric and a sample "below" on its own page; here they stand alone.
const gradingRows = [...pack.grading.map(([item, w, how]) => [item, w, how.replace(/\s*(Rubric|Sample) below\.\s*$/, '')]), ['Checks', '0%', 'The weekly three-question check. Practice, and not counted.']];
const runs = pack.runs.filter(([k]) => ['Format', 'Before class', 'In class', 'The lab', 'Tools', 'Help'].includes(k));

// Class 2's plan, with its minutes.
let t = 0;
const steps = class2.steps.map((s) => { const from = t; t += s.min; return { ...s, from, to: t }; });
const who = { me: 'Me, at the front', you: 'You, working', room: 'The room, laptops closed' } as const;
---
<div class="mdl" data-mdl data-start={start}>
  <div class="mdl-bar"><h1 class="mdl-brand">Meow-Dle</h1></div>
  <div class="mdl-top">
    <nav class="mdl-crumbs" aria-label="Breadcrumb">
      <ol data-crumbs><li><a href="#mdl-course">{course.code}</a></li></ol>
    </nav>
    <p class="mdl-term">{course.section} · {course.term}</p>
  </div>
  <nav class="mdl-tabs" aria-label="Course">
    <ul>{tabs.map(([id, t]) => <li><a href={`#${id}`}><span>{t}</span></a></li>)}</ul>
  </nav>
  <div class="mdl-body">
    <nav class="mdl-index" aria-label="Course index">
      <p class="label">Course index</p>
      <ul>
        <li><a href="#mdl-s0">General</a></li>
        {weeks.map((w) => <li><a href={`#mdl-w${w.w}`} class={w.w === now ? 'is-now' : undefined}>{w.topic}<span class="mdl-meta">Week {w.w}{w.w === now && ' · this week'}</span></a></li>)}
      </ul>
    </nav>
    <div class="mdl-main">

      <div class="mdl-panel" id="mdl-course" data-tab="mdl-course">
        <h2 tabindex="-1">{course.title}</h2>
        <div class="mdl-card">
          <p class="label">{course.code} · {course.section}</p>
          <p>{course.line}</p>
          <p><strong>The project.</strong> {course.project}</p>
        </div>
        <p class="mdl-note">{course.standing} {moment}</p>

        <section class="mdl-sec" id="mdl-s0">
          <h3 class="mdl-sec-head"><span class="mdl-sec-name">General</span></h3>
          <ul class="mdl-items">
            {general.map((i) => (
              <li>
                <span class="mdl-type label">{i.type}</span>
                <span class="mdl-what">{i.href ? <a href={i.href}>{i.title}</a> : <span>{i.title}</span>}{i.text && <span class="mdl-desc">{i.text}</span>}</span>
                <span class="mdl-meta"></span>
                <span class="mdl-state"></span>
              </li>
            ))}
          </ul>
        </section>

        {weeks.map((w) => (
          <details class:list={['mdl-sec', { 'is-now': w.w === now }]} id={`mdl-w${w.w}`} open={w.w === now}>
            <summary class="mdl-sec-head"><span class="mdl-sec-name">{w.topic}</span><span class="mdl-meta">Week {w.w}{w.w === now && <span class="mdl-pill is-done mdl-now">This week</span>}</span></summary>
            {w.w === now && <p class="mdl-sec-text">This week: fitting a line, then two inputs at once. Class 2 asks a question a record label faces, with 150 real songs.</p>}
            <ul class="mdl-items">
              {w.items.map((i) => isLabel(i) ? (
                <li class="mdl-label"><span>{i.label}</span></li>
              ) : (
                <li>
                  <span class="mdl-type label">{i.type}</span>
                  <span class="mdl-what">{i.href ? <a href={i.href}>{i.title}</a> : <span>{i.title}</span>}{i.text && <span class="mdl-desc">{i.text}</span>}</span>
                  <span class="mdl-meta">{i.note}</span>
                  <span class="mdl-state">{i.done ? <span class="mdl-pill is-done">Done</span> : <span class="mdl-pill">To do</span>}</span>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>

      <div class="mdl-panel" id="mdl-participants" data-tab="mdl-participants" data-crumb="Participants">
        <h2 tabindex="-1">Participants</h2>
        <table class="mdl-table">
          <thead><tr><th scope="col">Name</th><th scope="col">Roles</th><th scope="col">In this course</th></tr></thead>
          <tbody>{people.map((p) => <tr><td>{p.name}</td><td>{p.role}</td><td>{p.note}</td></tr>)}</tbody>
        </table>
        <h3 class="mdl-sub">Groups</h3>
        <p>Project teams of four, from week 4. Pairs for class work are set in class.</p>
        <ul class="mdl-chips">{['Team 1', 'Team 2', 'Team 3', 'Team 4', 'Team 5'].map((t) => <li class="chip">{t}</li>)}</ul>
      </div>

      <div class="mdl-panel" id="mdl-grades" data-tab="mdl-grades" data-crumb="Grades">
        <h2 tabindex="-1">Grades</h2>
        <h3 class="mdl-sub">Grade categories</h3>
        <table class="mdl-table">
          <thead><tr><th scope="col">Category</th><th scope="col">Weight</th><th scope="col">How it is graded</th></tr></thead>
          <tbody>{gradingRows.map(([item, w, how]) => <tr><td>{item}</td><td class="nb">{w}</td><td>{how}</td></tr>)}</tbody>
        </table>
        <h3 class="mdl-sub">User report: a sample student, weeks 9 to 11</h3>
        <table class="mdl-table">
          <thead><tr><th scope="col">Grade item</th><th scope="col">Grade</th><th scope="col">Range</th><th scope="col">Feedback</th></tr></thead>
          <tbody>{grades.map((r) => <tr><td>{r.name}<span class="mdl-meta mdl-due">{r.cat} · Week {r.week}</span></td><td class="nb">{r.grade}</td><td class="nb">{r.range}</td><td>{r.feedback}</td></tr>)}</tbody>
        </table>
        <p class="mdl-note">{gradesNote}</p>
      </div>

      <div class="mdl-panel" id="mdl-syllabus" data-tab="mdl-course" data-index="mdl-s0" data-crumb="General|Syllabus">
        <h2 tabindex="-1">Syllabus</h2>
        {pack.description.slice(0, 1).map((p) => <p>{p}</p>)}
        <dl class="mdl-runs">{runs.map(([k, v]) => <div><dt class="label">{k}</dt><dd>{v}</dd></div>)}</dl>
        <p class="mdl-coda"><a href="/bucknell/anop-102/">The whole course, week by week, with the rubrics and a sample final&nbsp;→</a></p>
        <p class="mdl-back"><a href="#mdl-course">← Back to the course</a></p>
      </div>

      <div class="mdl-panel" id="mdl-announcements" data-tab="mdl-course" data-index="mdl-s0" data-crumb="General|Announcements">
        <h2 tabindex="-1">Announcements</h2>
        {announcements.map((a) => (
          <article class="mdl-post">
            <p class="mdl-post-title">{a.title}</p>
            <p class="mdl-meta">Ali Rizvi · {a.week}</p>
            <p>{a.body}</p>
          </article>
        ))}
        <p class="mdl-back"><a href="#mdl-course">← Back to the course</a></p>
      </div>

      <div class="mdl-panel" id="mdl-toolpak" data-tab="mdl-course" data-index={`mdl-w${now}`} data-crumb="Regression|Turn on the Analysis ToolPak">
        <h2 tabindex="-1">Turn on the Analysis ToolPak</h2>
        <p>The ToolPak comes with desktop Excel, switched off. Turn it on once, before class 1.</p>
        <div class="mdl-two">
          <div><h3 class="mdl-sub">On Windows</h3><ol class="mdl-list">{toolpak.windows.map((s) => <li>{s}</li>)}</ol></div>
          <div><h3 class="mdl-sub">On a Mac</h3><ol class="mdl-list">{toolpak.mac.map((s) => <li>{s}</li>)}</ol></div>
        </div>
        <h3 class="mdl-sub">Running a regression</h3>
        <ol class="mdl-list">{toolpak.run.map((s) => <li>{s}</li>)}</ol>
        <p class="mdl-back"><a href="#mdl-course">← Back to the course</a></p>
      </div>

      <div class="mdl-panel" id="mdl-check" data-tab="mdl-course" data-index={`mdl-w${now}`} data-crumb={`Regression|${check.title}`}>
        <h2 tabindex="-1">{check.title}</h2>
        <p>{check.intro}</p>
        <p class="mdl-note">Try it. Pick an answer and press Check.</p>
        {check.questions.map((q, qi) => (
          <div class="mdl-q" role="group" aria-labelledby={`mdl-q${qi}-text`} data-q data-right={q.right}>
            <div class="mdl-q-info">
              <p class="mdl-q-n">Question {qi + 1}</p>
              <p class="mdl-meta" data-state aria-live="polite">Not yet answered</p>
              <p class="mdl-meta">1 point</p>
            </div>
            <div class="mdl-q-body">
              <p class="mdl-q-text" id={`mdl-q${qi}-text`}>{q.q}</p>
              <ul>
                {q.options.map((o, oi) => (
                  <li><label><input type="radio" name={`mdl-q${qi}`} value={oi} /> <span>{String.fromCharCode(97 + oi)}. {o}</span></label></li>
                ))}
              </ul>
              <button type="button" class="demo-btn" data-check>Check</button>
              <div class="mdl-q-fb" data-fb hidden aria-live="polite">
                <p class="mdl-q-verdict" data-verdict></p>
                <p>{q.feedback}</p>
                <p class="mdl-meta">The right answer: {String.fromCharCode(97 + q.right)}.</p>
              </div>
              <noscript><p class="mdl-meta">The right answer: {String.fromCharCode(97 + q.right)}. {q.feedback}</p></noscript>
            </div>
          </div>
        ))}
        <p class="mdl-back"><a href="#mdl-course">← Back to the course</a></p>
      </div>

      <div class="mdl-panel" id="mdl-class2" data-tab="mdl-course" data-index={`mdl-w${now}`} data-crumb={`Regression|${class2.title}`}>
        <h2 tabindex="-1">{class2.title}</h2>
        <p class="mdl-meta mdl-lede-meta">{class2.meta}</p>
        <p>{class2.intro}</p>
        <p><strong>Bring.</strong> {class2.bring}</p>
        <h3 class="mdl-sub">By the end of class you can</h3>
        <ol class="mdl-list">{class2.outcomes.map((o) => <li>{o}</li>)}</ol>

        <h3 class="mdl-sub">The plan</h3>
        <div class="cls mdl-plan">
          <div class="cls-bar" aria-hidden="true">{steps.map((s) => <span class:list={[s.who, { 'is-core': s.core }]} style={`flex: ${s.min} ${s.min} 0`} />)}</div>
          <div class="mdl-core-bar" aria-hidden="true">{steps.map((s) => <span class:list={{ 'is-core': s.core }} style={`flex: ${s.min} ${s.min} 0`} />)}</div>
          <p class="mdl-aside"><span class="mdl-core-sw" aria-hidden="true"></span>Marked: the 30 minutes I teach on my campus visit (minutes 5 to 35). {class2.scope}</p>
          <ol class="cls-steps">
            {steps.map((s) => (
              <li class:list={{ 'is-core': s.core }}>
                <span class="cls-min">{s.from}-{s.to}</span>
                <span class={`sw ${s.who}`} aria-hidden="true" />
                <span class="cls-text"><span class="mdl-sr">{who[s.who]}{s.core && ', on the visit'}: </span><b>{s.title}</b> {s.text}</span>
              </li>
            ))}
          </ol>
          <p class="cls-legend">{(['me', 'you', 'room'] as const).map((k) => <span><span class={`sw ${k}`} aria-hidden="true" />{who[k]}</span>)}</p>
        </div>

        <h3 class="mdl-sub">The data</h3>
        <p>{class2.data} <a href={class2.source}>The dataset on Kaggle</a>.</p>

        <h3 class="mdl-sub">Try it</h3>
        <ol class="mdl-tries">{class2.tries.map((x) => <li><strong>{x.do}</strong> {x.see}</li>)}</ol>
        <SongsDemo />
        <p class="mdl-coda"><a href="#mdl-lab11">Open lab 11&nbsp;→</a></p>
        <p class="mdl-back"><a href="#mdl-course">← Back to the course</a></p>
      </div>

      <div class="mdl-panel" id="mdl-lab11" data-tab="mdl-course" data-index={`mdl-w${now}`} data-crumb={`Regression|${lab11.title}`}>
        <h2 tabindex="-1">{lab11.title}</h2>
        <dl class="mdl-facts">
          <div><dt class="label">Opened</dt><dd>{lab11.opened}</dd></div>
          <div><dt class="label">Due</dt><dd>{lab11.due}</dd></div>
          <div><dt class="label">Grading</dt><dd>{lab11.grading}</dd></div>
          <div><dt class="label">File types</dt><dd>{lab11.types}</dd></div>
        </dl>
        <h3 class="mdl-sub">Purpose</h3>
        <p>{lab11.purpose}</p>
        <h3 class="mdl-sub">Task</h3>
        <ol class="mdl-list">{lab11.task.map((t) => <li>{t}</li>)}</ol>
        <h3 class="mdl-sub">Criteria</h3>
        <p>{lab11.criteria}</p>
        <div class="mdl-scroll" tabindex="0" role="region" aria-label="Lab 11 rubric">
          <table class="mdl-table mdl-rubric">
            <caption class="label">Grading criteria</caption>
            <thead><tr><th scope="col">Criterion</th><th scope="col">2 points</th><th scope="col">1 point</th><th scope="col">0 points</th></tr></thead>
            <tbody>
              {lab11.rubric.map((row) => (
                <tr>
                  <th scope="row">{row.name}</th>
                  {row.levels.map((l, i) => <td class={i === 0 ? 'top' : undefined}>{l}</td>)}
                </tr>
              ))}
            </tbody>
            <tfoot><tr><td colspan="4">Passes at 6 of 8, with no row at 0</td></tr></tfoot>
          </table>
        </div>
        <table class="mdl-table mdl-status">
          <caption class="label">Submission status · a sample student</caption>
          <tbody>
            <tr><th scope="row">Submission status</th><td>No submission yet</td></tr>
            <tr><th scope="row">Grading status</th><td>Not graded</td></tr>
            <tr><th scope="row">Due</th><td>Before class 1 of week 12</td></tr>
            <tr><th scope="row">First page</th><td>A photo of the exit ticket from class 2</td></tr>
          </tbody>
        </table>
        <p class="mdl-back"><a href="#mdl-course">← Back to the course</a></p>
      </div>

    </div>
  </div>
</div>

<style>
  .mdl { margin-top: 4rem; border: 2px solid #000; background: #fff; font-size: 16px; }
  .mdl p { max-width: 66ch; }
  /* The name across the top, as Moodle shows a site's name: Meow-Dle, in text. It is the page's h1. */
  .mdl-bar { padding: 10px 18px; border-bottom: 1px solid #000; }
  .mdl-brand { margin: 0; font-weight: 700; font-size: 1.15rem; line-height: 1.3; letter-spacing: inherit; }
  .mdl-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; padding: 12px 18px 8px; }
  .mdl-crumbs ol { list-style: none; margin: 0; padding: 0; max-width: none; display: flex; flex-wrap: wrap; gap: 0 8px; font-weight: 600; }
  /* The breadcrumb's items are written by the script, so their rules are global (inside .mdl-crumbs). */
  .mdl-crumbs :global(li) { margin: 0; }
  .mdl-crumbs :global(li + li)::before { content: '/'; margin-right: 8px; font-weight: 400; }
  .mdl-crumbs :global(a) { text-decoration: none; }
  .mdl-crumbs :global(a:hover) { text-decoration: underline; }
  .mdl-term { margin: 0 0 0 auto; color: rgba(0, 0, 0, 0.6); font-size: 14px; }

  /* The tabs across the top: Course, Participants, Grades. */
  .mdl-tabs { border-bottom: 1px solid #000; padding: 0 10px; }
  .mdl-tabs ul { list-style: none; margin: 0; padding: 0; max-width: none; display: flex; flex-wrap: wrap; }
  .mdl-tabs li { margin: 0; }
  .mdl-tabs a { display: block; padding: 8px 10px 6px; border-bottom: 4px solid transparent; color: #000; text-decoration: none; }
  .mdl-tabs a:hover { background: var(--hl-soft, #eee); }
  .mdl-tabs a[aria-current] { border-bottom-color: #000; font-weight: 600; }
  .mdl-tabs a[aria-current] span { background: linear-gradient(transparent 52%, var(--hl, #ccc) 52%); }

  /* The course index down the side. */
  .mdl-body { display: grid; grid-template-columns: 13.5rem minmax(0, 1fr); }
  .mdl-index { border-right: 1px solid rgba(0, 0, 0, 0.25); padding: 14px 0; }
  .mdl-index .label { margin: 0 0 6px; padding: 0 16px; }
  .mdl-index ul { list-style: none; margin: 0; padding: 0; max-width: none; }
  .mdl-index li { margin: 0; }
  .mdl-index a { display: block; padding: 5px 12px; border-left: 4px solid transparent; color: #000; text-decoration: none; font-size: 15px; line-height: 1.3; }
  .mdl-index a:hover { background: var(--hl-soft, #eee); }
  .mdl-index a.is-now { font-weight: 600; }
  .mdl-index a[aria-current] { border-left-color: #000; font-weight: 600; background: var(--hl-soft, #eee); }
  .mdl-index .mdl-meta { display: block; font-size: 12px; font-weight: 400; }

  .mdl-main { min-width: 0; padding: 18px 22px 24px; }
  .mdl-panel h2 { margin: 0 0 14px; font-size: 1.35rem; outline: none; }
  .mdl-panel + .mdl-panel { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid #000; }
  .mdl.js .mdl-panel:not(.is-on) { display: none; }
  .mdl.js .mdl-panel + .mdl-panel { margin-top: 0; padding-top: 0; border-top: 0; }
  .mdl-sub { margin: 1.5rem 0 0.4rem; font-size: 1rem; font-weight: 600; line-height: 1.4; letter-spacing: inherit; }
  .mdl-panel > h2 + .mdl-sub { margin-top: 0; }
  .mdl-list { margin: 0 0 1em; }
  .mdl-meta { color: rgba(0, 0, 0, 0.6); font-size: 14px; }
  .mdl-lede-meta { margin: -8px 0 12px; }
  .mdl-note { margin: 12px 0 0; color: rgba(0, 0, 0, 0.6); font-size: 14px; }
  .mdl-back { margin-top: 1.25rem; }
  .mdl-coda { margin-top: 1.25rem; }
  .mdl-tries { margin: 0 0 1.25rem; }

  /* The course page: the course card, with the band in the section colour, then the sections. */
  .mdl-card { border: 2px solid #000; box-shadow: inset 0 8px 0 var(--hl, #ccc); padding: 22px 18px 6px; }
  .mdl-card .label { margin-bottom: 6px; }
  .mdl-sec { border: 1px solid #000; margin-top: 8px; }
  .mdl-sec.is-now, #mdl-s0 { margin-top: 12px; }
  .mdl-sec.is-now { border-width: 2px; }
  .mdl-sec-head { display: grid; grid-template-columns: 1ch minmax(0, 1fr) auto; align-items: baseline; gap: 2px 12px; margin: 0; padding: 8px 14px; font-size: 1rem; font-weight: 600; }
  /* Only this week's header carries the section colour, so the week stands out among the closed ones. */
  .mdl-sec.is-now > .mdl-sec-head { padding: 10px 14px; background: var(--hl-soft, #f2f2f2); }
  h3.mdl-sec-head { grid-template-columns: minmax(0, 1fr); letter-spacing: inherit; line-height: inherit; }
  summary.mdl-sec-head { cursor: pointer; list-style: none; }
  summary.mdl-sec-head::-webkit-details-marker { display: none; }
  summary.mdl-sec-head::before { content: '+'; font-weight: 400; }
  .mdl-sec[open] > summary.mdl-sec-head::before { content: '−'; }
  .mdl-sec-head .mdl-meta { font-weight: 400; white-space: nowrap; }
  .mdl-now { margin-left: 8px; }
  .mdl .mdl-sec-text { max-width: none; margin: 0; padding: 10px 14px; border-top: 1px solid #000; }
  .mdl-items { list-style: none; margin: 0; padding: 0; max-width: none; }
  .mdl-items li { display: grid; grid-template-columns: 6.2rem minmax(0, 1fr) auto 3.9rem; align-items: baseline; gap: 2px 12px; margin: 0; padding: 9px 14px; border-top: 1px solid rgba(0, 0, 0, 0.2); }
  .mdl-items li.mdl-label { display: block; padding: 14px 14px 4px; border-top: 1px solid #000; font-weight: 600; }
  .mdl-items li.mdl-label + li { border-top: 0; }
  .mdl-type { font-size: 12px; letter-spacing: 0.1em; }
  .mdl-desc { display: block; margin-top: 2px; color: rgba(0, 0, 0, 0.6); font-size: 14px; }
  .mdl-items .mdl-meta { text-align: right; white-space: nowrap; }
  .mdl-state { text-align: right; }
  /* The completion mark. Pills are the one rounded element on the site. */
  .mdl-pill { display: inline-block; padding: 2px 9px 1px; border: 1px solid rgba(0, 0, 0, 0.45); border-radius: 999px; font-size: 12px; line-height: 1.4; white-space: nowrap; color: rgba(0, 0, 0, 0.6); }
  .mdl-pill.is-done { border-color: #000; background: var(--hl, #ccc); color: #000; }

  .mdl-chips { list-style: none; margin: 8px 0 0; padding: 0; max-width: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .mdl-chips li { margin: 0; }
  .mdl-post { border-top: 1px solid rgba(0, 0, 0, 0.2); padding: 12px 0 2px; }
  .mdl-post-title { margin: 0; font-weight: 600; }
  .mdl-post .mdl-meta { margin: 2px 0 8px; }

  .mdl-runs { margin: 1rem 0 0; }
  .mdl-runs div { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 4px 16px; padding: 8px 0; border-top: 1px solid rgba(0, 0, 0, 0.2); }
  .mdl-runs dd { margin: 0; max-width: 66ch; }
  .mdl-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--gutter, 24px); }

  /* The check: one question to a box, with Moodle's question info beside it. */
  .mdl-q { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 0 18px; margin: 16px 0 0; padding: 14px 0 0; border-top: 1px solid #000; min-width: 0; }
  .mdl-q-info p { margin: 0; }
  .mdl-q-n { font-weight: 600; }
  .mdl-q-text { margin: 0 0 8px; font-weight: 600; }
  .mdl-q ul { list-style: none; margin: 0 0 12px; padding: 0; max-width: none; }
  .mdl-q li { margin: 0; }
  .mdl-q label { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 8px; padding: 5px 0; cursor: pointer; }
  .mdl-q input { margin: 4px 0 0; accent-color: #000; }
  .mdl-q-fb { margin-top: 12px; padding: 10px 14px; border-left: 4px solid #000; background: var(--hl-soft, #f2f2f2); }
  .mdl-q-fb.is-right { border-left-color: #000; background: var(--hl, #ccc); }
  .mdl-q-fb p { margin: 0 0 4px; }
  .mdl-q-verdict { font-weight: 600; }

  /* Class 2's plan, in the colours of the other class plans on the site, with the visit's 30 minutes marked. */
  .mdl-plan { margin-top: 4px; }
  .mdl-core-bar { display: flex; gap: 2px; height: 6px; margin-top: 3px; }
  .mdl-core-bar span { display: block; min-width: 0; }
  .mdl-core-bar .is-core, .mdl-core-sw { background: #000; }
  .mdl-core-sw { display: inline-block; width: 18px; height: 6px; margin-right: 8px; vertical-align: 2px; }
  .mdl-aside { margin: 10px 0 4px; font-size: 14px; }
  .mdl-plan .cls-steps li.is-core { background: var(--hl-soft, #f2f2f2); box-shadow: inset 4px 0 0 #000; padding-left: 10px; padding-right: 8px; grid-template-columns: 3rem 10px minmax(0, 1fr); }
  .mdl-plan .cls-steps li:first-child { padding-top: 8px; }

  .mdl-table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .mdl-table caption { text-align: left; padding: 18px 0 6px; }
  .mdl-table th, .mdl-table td { text-align: left; vertical-align: top; padding: 7px 12px 7px 0; border-top: 1px solid rgba(0, 0, 0, 0.2); }
  .mdl-table thead th { font-weight: 600; border-top: 0; border-bottom: 1px solid #000; }
  .mdl-table tfoot td { font-weight: 600; border-top: 1px solid #000; }
  .mdl-status th { width: 11rem; font-weight: 600; }
  .mdl-status tr:first-child th, .mdl-status tr:first-child td { border-top: 1px solid #000; }
  .mdl-rubric tbody th { font-weight: 600; width: 8rem; }
  .mdl-rubric td.top { background: var(--hl-soft, #f2f2f2); }
  .mdl-scroll { overflow-x: auto; }
  .mdl-scroll:focus-visible { outline: 2px solid #000; outline-offset: 2px; }
  .mdl-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .mdl-table td, .mdl-table th { overflow-wrap: anywhere; }
  .mdl-due { display: block; font-size: 13px; }
  .mdl-facts { display: flex; flex-wrap: wrap; gap: 8px 28px; margin: 0 0 6px; padding: 10px 0; border-top: 1px solid #000; border-bottom: 1px solid #000; }
  .mdl-facts dd { margin: 2px 0 0; }

  /* A tablet: the course index is left out, as Moodle closes its drawer (the weeks are on the course page), and
     each activity's dates sit under its title. */
  @media (max-width: 1023px) {
    .mdl-body { grid-template-columns: minmax(0, 1fr); }
    .mdl-index { display: none; }
    .mdl-items li { grid-template-columns: 6.2rem minmax(0, 1fr) auto; }
    .mdl-items .mdl-type { grid-column: 1; grid-row: 1; }
    .mdl-items .mdl-what { grid-column: 2; grid-row: 1; }
    .mdl-items .mdl-meta { grid-column: 2; grid-row: 2; text-align: left; white-space: normal; }
    .mdl-items .mdl-state { grid-column: 3; grid-row: 1; }
  }
  /* A phone: the tabs stay in view, and each row stacks, with the completion mark beside the activity's type. */
  @media (max-width: 767px) {
    .mdl-bar { padding: 8px 14px; }
    .mdl-top { padding: 10px 14px 6px; }
    .mdl-term { margin-left: 0; }
    .mdl-tabs { padding: 0 4px; position: sticky; top: 0; z-index: 3; background: #fff; }
    .mdl-main { padding: 14px 14px 20px; }
    .mdl-items li { grid-template-columns: minmax(0, 1fr) auto; padding: 9px 12px; }
    .mdl-items .mdl-state { grid-column: 2; grid-row: 1; }
    .mdl-items .mdl-what { grid-column: 1 / -1; grid-row: 2; }
    .mdl-items .mdl-meta { grid-column: 1 / -1; grid-row: 3; }
    .mdl-sec-head { grid-template-columns: 1ch minmax(0, 1fr); padding: 10px 12px; }
    .mdl-sec-head .mdl-meta { grid-column: 2; }
    h3.mdl-sec-head { grid-template-columns: minmax(0, 1fr); }
    .mdl .mdl-sec-text { padding: 10px 12px; }
    .mdl-table th, .mdl-table td { padding-right: 8px; }
    .mdl-status th { width: 7.5rem; }
    .mdl-runs div, .mdl-two, .mdl-q { grid-template-columns: minmax(0, 1fr); }
    .mdl-q-info { display: flex; flex-wrap: wrap; gap: 0 12px; margin-bottom: 6px; }
    .mdl-rubric { min-width: 560px; }
    /* The tabs stay in view, so whatever a link opens lands below them. */
    .mdl-sec, .mdl-panel, .mdl-panel [id] { scroll-margin-top: 56px; }
  }
  @media (max-width: 420px) {
    .mdl-table .nb { white-space: normal; }
  }
  @media print {
    .mdl { margin-top: 2rem; }
    .mdl.js .mdl-panel:not(.is-on) { display: block; }
    .mdl.js .mdl-panel + .mdl-panel { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid #000; }
    .mdl-tabs, .mdl-index { display: none; }
    .mdl-body { grid-template-columns: minmax(0, 1fr); }
    .mdl-sec:not([open]) > :not(summary) { display: block; }
  }
</style>

<script>
  // One panel at a time. The tabs, the course index, the breadcrumb and any link to a panel (or to something inside
  // one, such as a week on the course page) open it; the address keeps it, so a link from elsewhere opens it too.
  const shell = document.querySelector<HTMLElement>('[data-mdl]');
  if (shell) {
    const panels = [...shell.querySelectorAll<HTMLElement>('.mdl-panel')];
    const tabs = [...shell.querySelectorAll<HTMLAnchorElement>('.mdl-tabs a')];
    const index = [...shell.querySelectorAll<HTMLAnchorElement>('.mdl-index a')];
    const crumbs = shell.querySelector<HTMLOListElement>('[data-crumbs]')!;
    const home = crumbs.firstElementChild!.cloneNode(true);
    const mark = (links: HTMLAnchorElement[], id?: string) => {
      for (const a of links) {
        if (id && a.getAttribute('href') === `#${id}`) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      }
    };
    // el: what was asked for (a panel, or something inside one). Its panel shows; the tab, the course index and the
    // breadcrumb follow.
    const show = (panel: HTMLElement, el: HTMLElement = panel) => {
      for (const p of panels) p.classList.toggle('is-on', p === panel);
      mark(tabs, panel.dataset.tab ?? panel.id);
      const sec = el.closest<HTMLElement>('.mdl-sec');
      mark(index, panel.dataset.index ?? sec?.id);
      const parts = (panel.dataset.crumb ?? '').split('|').filter(Boolean);
      crumbs.replaceChildren(home.cloneNode(true));
      parts.forEach((t, i) => {
        const li = document.createElement('li');
        if (i < parts.length - 1) { const a = document.createElement('a'); a.href = `#${panel.dataset.index ?? panel.dataset.tab ?? panel.id}`; a.textContent = t; li.append(a); }
        else { li.textContent = t; li.setAttribute('aria-current', 'page'); }
        crumbs.append(li);
      });
    };
    const target = (id: string) => { const el = id ? document.getElementById(id) : null; const p = el?.closest<HTMLElement>('.mdl-panel'); return p && shell.contains(p) ? { el: el!, p } : null; };
    const open = (t: { el: HTMLElement; p: HTMLElement }) => {
      show(t.p, t.el);
      if (t.el instanceof HTMLDetailsElement) t.el.open = true;
      if (t.el !== t.p) t.el.scrollIntoView({ block: 'start' });
      else if (shell.getBoundingClientRect().top < 0) shell.scrollIntoView({ block: 'start' });
    };
    shell.classList.add('js');
    const first = target(decodeURIComponent(location.hash.slice(1)));
    if (first) { open(first); if (first.el === first.p) shell.scrollIntoView({ block: 'start' }); }
    else { const s = target(shell.dataset.start ?? ''); show(s ? s.p : panels[0]); }
    shell.addEventListener('click', (e) => {
      const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href^="#mdl-"]'); if (!a) return;
      const t = target(decodeURIComponent(a.getAttribute('href')!.slice(1))); if (!t) return;
      e.preventDefault();
      open(t);
      history.pushState(null, '', a.getAttribute('href'));
      if (t.el === t.p && !a.closest('.mdl-tabs')) t.p.querySelector<HTMLElement>('h2')?.focus({ preventScroll: true });
    });
    window.addEventListener('hashchange', () => { const t = target(decodeURIComponent(location.hash.slice(1))); if (t) open(t); });
    // Back and Forward walk the panels opened inside the shell.
    window.addEventListener('popstate', () => {
      const t = target(decodeURIComponent(location.hash.slice(1))) ?? target(shell.dataset.start ?? '');
      if (t) open(t);
    });
    window.addEventListener('beforeprint', () => shell.querySelectorAll('details').forEach((d) => { d.open = true; }));
    // Links to a panel from outside the shell (the page's own copy) open it too.
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented) return;
      const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href^="#mdl-"]'); if (!a || shell.contains(a)) return;
      const t = target(decodeURIComponent(a.getAttribute('href')!.slice(1))); if (!t) return;
      e.preventDefault(); open(t); shell.scrollIntoView({ block: 'start' }); history.pushState(null, '', a.getAttribute('href'));
    });

    // The check: pick an answer, press Check, and the question says whether it is right, as Moodle's interactive
    // quizzes do.
    shell.querySelectorAll<HTMLFieldSetElement>('[data-q]').forEach((q) => {
      const right = Number(q.dataset.right);
      const btn = q.querySelector<HTMLButtonElement>('[data-check]')!;
      const fb = q.querySelector<HTMLElement>('[data-fb]')!;
      btn.addEventListener('click', () => {
        const picked = q.querySelector<HTMLInputElement>('input:checked');
        const state = q.querySelector<HTMLElement>('[data-state]')!;
        if (!picked) { state.textContent = 'Pick an answer first'; return; }
        const ok = Number(picked.value) === right;
        fb.hidden = false;
        fb.classList.toggle('is-right', ok);
        q.querySelector<HTMLElement>('[data-verdict]')!.textContent = ok ? 'Correct' : 'Not quite';
        state.textContent = ok ? 'Correct · 1 of 1 point' : 'Not quite · 0 of 1 point';
      });
    });
  }
</script>
