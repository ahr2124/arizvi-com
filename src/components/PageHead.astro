---
interface Props { label: string; title: string; lede?: string }
const { label, title, lede } = Astro.props;
---
<header class="page-head bone">
  <div class="container">
    <p class="label">{label}</p>
    <h1 class="page-title">{title}</h1>
    {lede && <p class="lede" style="margin-top:2rem">{lede}</p>}
  </div>
</header>
