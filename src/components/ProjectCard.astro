---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'> }
const { data: d } = Astro.props.project;
const bg = d.image ?? '/media/mark.svg';
const outputs = d.output.split(',').map((s) => s.trim()).filter(Boolean);
const Tag = d.link ? 'a' : 'article';
---
<Tag class:list={['card', { 'card-fallback': !d.image }]} href={d.link}>
  <div class="card-bg" style={`background-image:url('${bg}')`} aria-hidden="true"></div>
  <div class="card-body">
    <p class="label">{[d.years, ...d.venues].join(' · ')}</p>
    <h3>{d.title}</h3>
    <p class="card-summary">{d.summary}</p>
    <dl class="card-facts">
      <dt>Role</dt><dd>{d.role}</dd>
      <dt>Design</dt><dd>{d.process.design}</dd>
      <dt>Evaluate</dt><dd>{d.process.evaluate}</dd>
      <dt>Implement</dt><dd>{d.process.implement}</dd>
    </dl>
    <ul class="pills small" aria-label="Output">
      {outputs.map((o) => <li>{o}</li>)}
    </ul>
  </div>
</Tag>
