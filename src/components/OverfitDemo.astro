---
// Week 4 of ANOP 330: the model that memorised the past.
// Fit a curve to 16 days of an ice-cream stand's sales by temperature, pick the degree by the training error,
// then reveal the 8 days the model never saw. Fits are precomputed in src/data/overfit.ts.
import { train, test, grid, fits } from '../data/overfit';
const X = [14, 34], Y = [100, 600];
const left = (t: number) => ((t - X[0]) / (X[1] - X[0])) * 100;
const top = (y: number) => ((Y[1] - y) / (Y[1] - Y[0])) * 100;
const D0 = 1;
const path = (d: number) => fits[d].curve.map((y, i) => `${i ? 'L' : 'M'}${(left(grid.from + i * grid.step) * 10).toFixed(1)},${top(y).toFixed(2)}`).join(' ');
---
<div class="demo odemo" data-odemo>
  <div class="demo-controls odemo-controls">
    <div>
      <label class="label" for="odemo-d">Degree of the curve <output data-out="d" for="odemo-d">{D0}</output></label>
      <input type="range" id="odemo-d" min="1" max="10" step="1" value={D0} />
      <div class="demo-scale label" aria-hidden="true"><span>1 · a straight line</span><span>10 · up to 9 bends</span></div>
    </div>
    <div>
      <p class="label" id="odemo-r">The test</p>
      <div class="demo-pills" role="group" aria-labelledby="odemo-r">
        <button type="button" data-reveal aria-pressed="false">Reveal the 8 held-out days</button>
      </div>
    </div>
  </div>

  <div class="demo-chart">
    <p class="label">Daily sales by temperature · 16 days to fit, 8 held out</p>
    <div class="odemo-plot" aria-hidden="true">
      <svg viewBox="0 0 1000 100" preserveAspectRatio="none"><path data-curve d={path(D0)} /></svg>
      {train.map(([t, y]) => <span class="odemo-pt" style={`left: ${left(t)}%; top: ${top(y)}%`} />)}
      {test.map(([t, y]) => <span class="odemo-pt held" hidden style={`left: ${left(t)}%; top: ${top(y)}%`} />)}
      <span class="demo-y label" style="top: 0">$600</span>
      <span class="demo-y label" style={`top: ${top(350)}%`}>$350</span>
      <span class="demo-y label" style="top: 100%">$100</span>
    </div>
    <div class="demo-x label" aria-hidden="true"><span>14 °C</span><span class="mid" style="left: 50%;">24 °C</span><span class="end">34 °C</span></div>
  </div>

  <dl class="demo-readout odemo-readout">
    <div><dt class="label">Degree</dt><dd data-out="deg">{D0}</dd></div>
    <div><dt class="label"><span class="swi deep" aria-hidden="true" />Error on the 16 days</dt><dd data-out="tr">${fits[D0].train}</dd></div>
    <div><dt class="label"><span class="swi warm" aria-hidden="true" />Error on the 8 held out</dt><dd data-out="te">?</dd></div>
  </dl>
  <p class="demo-note" aria-live="polite" data-note></p>

  <p class="demo-coda">What counts is the error on data the model never saw. The lab repeats this 5 times (cross-validation).</p>
</div>

<script>
  import { fits } from '../data/overfit';
  document.querySelectorAll<HTMLElement>('[data-odemo]').forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const slider = $<HTMLInputElement>('#odemo-d');
    const btn = $<HTMLButtonElement>('[data-reveal]');
    const held = [...root.querySelectorAll<HTMLElement>('.odemo-pt.held')];
    const X = [14, 34], Y = [100, 600];
    const left = (t: number) => ((t - X[0]) / (X[1] - X[0])) * 100;
    const top = (y: number) => ((Y[1] - y) / (Y[1] - Y[0])) * 100;

    function update() {
      const d = Number(slider.value);
      const f = fits[d];
      const shown = btn.getAttribute('aria-pressed') === 'true';
      $('[data-curve]').setAttribute('d', f.curve.map((y, i) => `${i ? 'L' : 'M'}${(left(14 + i * 0.5) * 10).toFixed(1)},${top(y).toFixed(2)}`).join(' '));
      held.forEach((el) => { el.hidden = !shown; });
      $('[data-out=d]').textContent = String(d);
      $('[data-out=deg]').textContent = String(d);
      $('[data-out=tr]').textContent = '$' + f.train;
      $('[data-out=te]').textContent = shown ? '$' + f.test.toLocaleString('en-CA') : '?';
      const verdict = d === 1 ? "Too simple: a straight line cannot bend, so it misses both sets."
        : d <= 4 ? 'This is the one to ship. It follows the shape, and it holds on days it never saw.'
        : d <= 6 ? 'It has started fitting the noise. The error on new days is climbing, and the training error gives no warning.'
        // From degree 7 the 34 °C day carries most of the held-out miss (76%, 88%, 96%, 99.5% of the squared error at 7 to 10).
        // Without it, the other 7 held-out days miss by $31, $29 and $33 at degrees 2 to 4, and by $220 at degree 10.
        : d <= 8 ? 'It is fitting the noise. The error on new days is climbing, most of it on the 34 °C day, 1 degree hotter than anything it was fitted to, and the training error gives no warning.'
        : 'It memorized the 16 days and has nothing useful to say about any other. Nearly all of that miss is the 34 °C day, 1 degree hotter than anything it was fitted to.'
          + (d === 10 ? ' Leave that day out and it still misses the other 7 by $220, against about $30 at degrees 2 to 4.' : '');
      $('[data-note]').textContent = shown
        ? `Degree ${d}: $${f.train} off on the days it trained on, $${f.test.toLocaleString('en-CA')} on the 8 it never saw. ${verdict}`
        : `Degree ${d}: the curve misses the 16 days by $${f.train} a day (root-mean-square error). ${d < 10 ? 'Raise the degree and that error never goes up.' : 'That is as low as it goes.'} Pick the degree you would ship, then reveal the held-out days.`;
    }
    slider.addEventListener('input', update);
    btn.addEventListener('click', () => { btn.setAttribute('aria-pressed', String(btn.getAttribute('aria-pressed') !== 'true')); update(); });
    update();
  });
</script>
