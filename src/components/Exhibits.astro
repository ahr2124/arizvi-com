---
import { getCollection } from 'astro:content';
import Cover from './Cover.astro';
interface Props { all?: boolean }
const { all = false } = Astro.props;
const items = (await getCollection('work', ({ data, body }) => (all ? !!body?.trim() : data.featured)))
  .sort((a, b) => a.data.order - b.data.order);
const kind = { venture: 'Venture', industry: 'Industry', research: 'Research' };
---
<div class="exhibits">
  {items.map((e) => (
    <a class="item" href={`/work/${e.id}/`}>
      <Cover entry={e} />
      <p class="label">{e.data.years} · {kind[e.data.kind]}</p>
      <h3>{e.data.title}</h3>
      <p>{e.data.summary}</p>
    </a>
  ))}
</div>
