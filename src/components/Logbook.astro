---
import { getCollection } from 'astro:content';
interface Props { kinds?: string[]; limit?: number }
const { kinds, limit } = Astro.props;
let entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
if (kinds) entries = entries.filter((e) => kinds.includes(e.data.kind));
if (limit) entries = entries.slice(0, limit);
const kind = { venture: 'Venture', industry: 'Industry', research: 'Research' };
---
<table class="logbook">
  <thead>
    <tr><th class="years">Years</th><th>Role</th><th>Kind</th><th>What it was</th></tr>
  </thead>
  <tbody>
    {entries.map((e) => (
      <tr>
        <td class="years">{e.data.years}</td>
        <td class="title">
          {e.body?.trim() ? <a href={`/work/${e.id}/`}>{e.data.title}</a> : e.data.title}
          <small>{e.data.role}</small>
        </td>
        <td class="kind">{kind[e.data.kind]}</td>
        <td class="summary">{e.data.summary}</td>
      </tr>
    ))}
  </tbody>
</table>
