---
// What is handed in and what it weighs, on a /bucknell course page. Reads the pack's grading rows, so the two never disagree,
// and ends with the one link to the full pack.
import Section from './Section.astro';
import { course } from '../data/bucknell';
import type { Pack } from '../data/packs/types';
interface Props { pack: Pack }
const { pack } = Astro.props;
const c = course(pack.slug);
const trim = (s: string) => s.replace(/\s*(Rubric|Rubrics|Sample) below\.?$/, '').trim();
---
<Section label="What is handed in" title="The mark, piece by piece" id="handed-in">
  <ul class="rows compact bk-wide">
    {pack.grading.map(([item, weight, how]) => (
      <li class="grid">
        <div class="label">{weight}</div>
        <div class="body"><span class="title">{item}</span><p>{trim(how)}</p></div>
      </li>
    ))}
  </ul>
  <p class="pack-cta"><a href={`/bucknell/${pack.slug}/pack/`}>{c.pack} →</a></p>
</Section>
