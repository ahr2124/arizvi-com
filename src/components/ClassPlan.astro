---
// A class you can try, explained: the scenario (the slot) beside the plan for the 75 minutes, with a bar that
// shows who has the floor, then the pre-class work, the lab that follows, and 3 things to try in the widget below.
import type { ClassPlan } from '../data/classes';
// `pack` false drops the link to the week in the course pack (for pages with no pack behind them).
interface Props { plan: ClassPlan; course: string; pack?: boolean }
const { plan, course, pack = true } = Astro.props;
const total = plan.steps.reduce((s, x) => s + x.min, 0);
const who = { me: 'Me, at the front', you: 'You, working', room: 'The room, laptops closed' } as const;
let t = 0;
const steps = plan.steps.map((s) => { const from = t; t += s.min; return { ...s, from, to: t }; });
---
<div class="cls">
  <div class="cls-head grid">
    <div class="cls-intro"><slot /></div>
    <aside class="cls-side">
      <p class="label">The class · {total} minutes</p>
      <div class="cls-bar" aria-hidden="true">{steps.map((s) => <span class={s.who} style={`flex: ${s.min} ${s.min} 0`} />)}</div>
      <ol class="cls-steps">
        {steps.map((s) => (
          <li>
            <span class="cls-min">{s.from}-{s.to}</span>
            <span class={`sw ${s.who}`} aria-hidden="true" />
            <span class="cls-text"><b>{s.title}</b> {s.text}</span>
          </li>
        ))}
      </ol>
      <p class="cls-legend">{(['me', 'you', 'room'] as const).map((k) => <span><span class={`sw ${k}`} aria-hidden="true" />{who[k]}</span>)}</p>
      <dl class="cls-kv">
        <dt class="label">Before class</dt>
        <dd>{plan.before}</dd>
        <dt class="label">The lab that follows</dt>
        <dd>{plan.lab}{pack && <> <a class="cls-more" href={`/bucknell/${course}/pack/#week-${plan.week}`}>Week {plan.week} in the pack&nbsp;→</a></>}</dd>
      </dl>
    </aside>
    <div class="cls-try">
      <p class="label">{plan.triesLabel ?? 'Try it'}</p>
      <ol>
        {plan.tries.map((x, i) => (
          <li>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <p><b>{x.do}</b> {x.see}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</div>
