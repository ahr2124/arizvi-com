---
// An assignment: the prompt, what to do, what to hand in, and the rubric it is graded on.
// Each rubric row has 3 levels, best first, each with its points and a description. The rubric reads down one column:
// the criterion and its points, the sentence that earns full credit, then the lesser levels in grey on one line.
export interface Level { pts: number; text: string }
export interface Criterion { name: string; levels: [Level, Level, Level] }
interface Props {
  title: string;
  meta: string;             // weight and timing, e.g. "One of the weekly labs · week 3"
  prompt: string[];         // paragraphs
  steps?: string[];         // what to do, in order
  stepsLabel?: string;
  handIn?: string[];
  rubric: Criterion[];
  note?: string;            // a line under the rubric
  rubricLabel?: string;     // replaces "How it is graded · N points"
  heads?: [string, string, string];
}
const { title, meta, prompt, steps = [], stepsLabel = 'Do', handIn = [], rubric, note, rubricLabel, heads = ['Full credit', 'Part way', 'Not there'] } = Astro.props;
const total = rubric.reduce((s, c) => s + c.levels[0].pts, 0);
const legend = `${heads[0]}, then ${heads[1].toLowerCase()} and ${heads[2].toLowerCase()}`;
---
<article class="asg">
  <header class="asg-head">
    <p class="label">{meta}</p>
    <h3>{title}</h3>
  </header>
  <div class="asg-body">
    <div class="asg-prompt">
      {prompt.map((p) => <p>{p}</p>)}
      {steps.length > 0 && (
        <>
          <p class="label asg-sub">{stepsLabel}</p>
          <ol>{steps.map((s) => <li>{s}</li>)}</ol>
        </>
      )}
      {handIn.length > 0 && (
        <>
          <p class="label asg-sub">Hand in</p>
          <ul>{handIn.map((s) => <li>{s}</li>)}</ul>
        </>
      )}
    </div>
    <div class="asg-rubric">
      <p class="label asg-sub">{rubricLabel ?? `How it is graded · ${total} points`}</p>
      <p class="muted rb-legend">{legend}.</p>
      <ul class="rubric-list">
        {rubric.map((c) => (
          <li>
            <div class="rb-head"><span class="rb-name">{c.name}</span><span class="rb-pts">{c.levels[0].pts} {c.levels[0].pts === 1 ? 'point' : 'points'}</span></div>
            <p class="rb-full">{c.levels[0].text}</p>
            <p class="rb-less">
              {c.levels.slice(1).map((l, i) => <><span class="lv" aria-label={`${heads[i + 1]}, ${l.pts} points`}>{l.pts}</span>{l.text}{i === 0 ? ' ' : ''}</>)}
            </p>
          </li>
        ))}
      </ul>
      {note && <p class="muted asg-note">{note}</p>}
    </div>
  </div>
</article>
