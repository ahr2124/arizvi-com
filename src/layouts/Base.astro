---
import '../styles/global.css';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, noindex = false, description = 'Ali Rizvi - HCI researcher. PhD, University of Waterloo. AI and interactive systems for the other 80%.' } = Astro.props;
const path = Astro.url.pathname;
const scholar = 'https://scholar.google.com/citations?user=ngAHmhEAAAAJ&hl=en&oi=ao';
const email = 'ali.rizvi@uwaterloo.ca';
const nav = [
  ['/projects/', 'Projects'],
  ['/teaching/', 'Teaching'],
  ['/work/', 'Work'],
  ['/about/', 'About'],
];
const footerNav: [string, [string, string][]][] = [
  ['Research', [
    ['/projects/', 'Research statement'],
    ['/projects/#projects', 'Projects'],
    ['/publications/', 'Publications'],
    [scholar, 'Google Scholar'],
  ]],
  ['Teaching', [
    ['/teaching/', 'Teaching'],
    ['/teaching/#courses', 'Courses taught'],
    ['/teaching/#mentoring', 'Mentoring'],
  ]],
  ['Work', [
    ['/work/', 'Work'],
    ['/work/scramble/', 'Proteus → Scramble Deck'],
    ['/work/bodhika/', 'Bodhika Labs'],
    ['/work/phd/', 'Constrained spaces'],
    ['/work/experimentation/', 'Experimentation at scale'],
    ['/work/#logbook', 'Logbook'],
  ]],
  ['More', [
    ['/about/', 'About'],
    ['/cv.pdf', 'Academic CV (PDF)'],
    ['/blog/', 'Blog'],
    ['/attitude/', 'About the mark'],
  ]],
];
const updated = new Date().toLocaleDateString('en-CA', { year: 'numeric', month: 'long' });
const current = (href: string) =>
  (href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined;
const ext = (href: string) => href.startsWith('http');
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Ali Rizvi' ? title : `${title} - Ali Rizvi`}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="preload" href="/fonts/CooperHewitt-Book.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/CooperHewitt-Semibold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/CooperHewitt-Medium.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <div class="brand">
          <a class="mark-link" href="/attitude/" aria-label="About the mark"><img class="mark" src="/media/mark.svg" alt="" width="28" height="28" /></a>
          <a class="wordmark" href="/">Ali Rizvi</a>
        </div>
        <nav class="label" aria-label="Primary">
          {nav.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
        </nav>
      </header>
      <main><slot /></main>
    </div>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <img class="mark" src="/media/mark-inverse.svg" alt="" width="36" height="36" />
            <p class="wordmark">Ali Rizvi</p>
            <p class="footer-line">AI and interactive systems for the other 80%.</p>
            <p class="footer-contact"><a href={`mailto:${email}`}>{email}</a></p>
          </div>
          {footerNav.map(([heading, links]) => (
            <nav class="footer-col" aria-label={heading}>
              <p class="label">{heading}</p>
              <ul>
                {links.map(([href, label]) => (
                  <li>{ext(href)
                    ? <a href={href} target="_blank" rel="noopener">{label}</a>
                    : <a href={href}>{label}</a>}</li>
                ))}
              </ul>
            </nav>
          ))}
        </div>
        <div class="footer-base label">
          <p>© {new Date().getFullYear()} Ali Rizvi · <a href="/licence/">CC BY-ND 4.0</a></p>
          <p>Updated {updated}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
